# Copier ce fichier en deploy/.env (jamais versionné) et adapter les valeurs.
# Les valeurs ci-dessous correspondent à src/Host/GestionStock.Api/appsettings.Development.json :
# elles ne conviennent qu'au poste de développement. En boutique, choisir un mot de passe fort.

POSTGRES_DB=gestionstock
POSTGRES_USER=gestionstock
POSTGRES_PASSWORD=gestionstock_dev

# Port de PostgreSQL sur la machine hôte (écoute sur 127.0.0.1 uniquement).
POSTGRES_PORT=5432

# Régime de TVA (RG37) : true si l'entreprise est assujettie (reçu HT / TVA 19,25 % / TTC), false sinon (prix nets).
ENTREPRISE_ASSUJETTIE_TVA=false

# Identité imprimée en tête des reçus (laisser vide ce qui ne doit pas figurer).
ENTREPRISE_NOM=GestionStock
ENTREPRISE_ADRESSE=
ENTREPRISE_TELEPHONE=
ENTREPRISE_NIU=
# Logo facultatif (PNG, JPEG ou WebP ; pas de SVG) : chemin dans le volume des fichiers, ex. identite/logo.png.
# Le copier avec : docker compose -f deploy/docker-compose.yml cp logo.png api:/donnees/fichiers/identite/logo.png
ENTREPRISE_LOGO=

# Poste de caisse de la boutique (les tickets sont numérotés en continu par poste).
CAISSE_POSTE=CAISSE-1

# Administrateur initial, créé au premier démarrage si la base ne contient aucun compte.
# Valeurs de développement : en boutique, choisir un mot de passe fort et le changer après la première connexion.
ADMIN_IDENTIFIANT=admin
ADMIN_MOT_DE_PASSE=Admin123!

# Port de l'API sur la machine hôte (accessible depuis le réseau de la boutique).
API_PORT=8080

# --- Sauvegardes (décision 32, docs/exploitation.md) ---------------------------------------------------------------
# Disque externe de la boutique, vu depuis l'hôte (ex. E:/sauvegardes sous Windows, /media/disque/sauvegardes sous Linux).
# Une archive par heure : base complète + fichiers (reçus, clés des jetons) ; 48 h d'horaires, 30 quotidiennes, 12 mensuelles.
SAUVEGARDE_REPERTOIRE=./sauvegardes
# Minute de chaque heure à laquelle la sauvegarde a lieu.
SAUVEGARDE_MINUTE=5

# Copie quotidienne chiffrée hors de la boutique, par rclone (vide = pas de copie hors site, signalée en retard).
# Distant rclone et dossier, ex. boutique:gestionstock ; le distant est décrit dans SAUVEGARDE_RCLONE/rclone.conf.
# ATTENTION (loi n° 2024/017) : la copie est complète (noms et téléphones des clients et du personnel compris). Elle
# n'est permise que vers un stockage situé au Cameroun, ou hors du Cameroun avec l'autorisation de transfert obtenue
# par la boutique.
SAUVEGARDE_DISTANT=
# Dossier de l'hôte qui contient rclone.conf (créé par « rclone config », jamais versionné).
SAUVEGARDE_RCLONE=./rclone
# Clé(s) publique(s) age du propriétaire (age1…), séparées par des espaces. La clé privée reste chez le propriétaire,
# jamais sur le serveur : elle seule permet de relire une copie hors site.
SAUVEGARDE_CLE_PUBLIQUE=
