root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{json,xml,csproj,props,targets,slnx,yml,yaml}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.cs]
csharp_style_namespace_declarations = file_scoped:warning
csharp_using_directive_placement = outside_namespace
dotnet_sort_system_directives_first = true
csharp_style_var_for_built_in_types = true
csharp_style_var_when_type_is_apparent = true
dotnet_style_qualification_for_field = false
dotnet_naming_rule.champs_prives.symbols = champs_prives
dotnet_naming_rule.champs_prives.style = prefixe_souligne
dotnet_naming_rule.champs_prives.severity = warning
dotnet_naming_symbols.champs_prives.applicable_kinds = field
dotnet_naming_symbols.champs_prives.applicable_accessibilities = private
dotnet_naming_style.prefixe_souligne.capitalization = camel_case
dotnet_naming_style.prefixe_souligne.required_prefix = _

# Migrations EF Core : code généré, exclu des règles de style et des analyseurs.
[**/Migrations/*.cs]
generated_code = true
dotnet_analyzer_diagnostic.severity = none
