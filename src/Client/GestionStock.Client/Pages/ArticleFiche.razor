@page "/articles/{Id:guid}"
@inject Api Api
@inject Confirmation Confirmation
@inject Session Session

<PageTitle>@(_article?.Code ?? L["Article"]) · GestionStock</PageTitle>

<p><a href="articles"><Icone Nom="retour" />@L["Articles"]</a></p>
<Message Texte="@_erreur" />
<Message Texte="@_succes" Erreur="false" />

@if (_article is null && _erreur is null)
{
    <Chargement />
}
else if (_article is not null)
{
    @* Maquette A : code et statut en badges, libellé en titre, chiffres du stock, conditionnements et derniers mouvements. *@
    <EntetePage>
        <Titre><span class="badges-titre"><code class="code-badge">@_article.Code</code><Pastille Ton="@(_article.Actif ? Ton.Succes : Ton.Neutre)">@(_article.Actif ? L["Actif"] : L["Inactif"])</Pastille></span>@Format.Libelle(_article)</Titre>
        <SousTitre>@L["UniteStock"] : @Format.Unite(_article.UniteStock) · @L["Precision"] : @_article.PrecisionQuantite</SousTitre>
        <Actions>
            @if (Session.A(Permissions.StockConsulter))
            {
                <a class="bouton" href="stock/@_article.Id">@L["JournalDuStock"]</a>
            }
        </Actions>
    </EntetePage>

    @if (_solde is { } solde)
    {
        <div class="indicateurs section">
            <Indicateur Libelle="@L["Physique"]" Valeur="@($"{Format.Quantite(solde.QuantitePhysique, _article.PrecisionQuantite)} {Format.Unite(_article.UniteStock)}")"
                        Ton="@(solde.QuantitePhysique < 0 ? Ton.Danger : Ton.Neutre)" />
            <Indicateur Libelle="@L["Cump"]" Valeur="@Format.Montant(solde.Cump)" />
            <Indicateur Libelle="@L["ValeurStock"]" Valeur="@Format.Montant(solde.QuantitePhysique * solde.Cump)" />
        </div>
    }

    <Tableau Titre="@L["ConditionnementsEtPrix"]" Colonnes="6" EstVide="_conditionnements.Count == 0" TexteVide="@L["AucunConditionnement"]" Legende="@L["ConditionnementsEtPrix"]">
        <Entete><th>@L["Conditionnement"]</th><th class="nombre">@L["Contenu"]</th><th>@L["Codes"]</th><th class="nombre">@L["PrixActuel"]</th><th>@L["PrixProgramme"]</th><th></th></Entete>
        <Corps>
            @foreach (var conditionnement in _conditionnements)
            {
                var prix = _prix.FirstOrDefault(p => p.ConditionnementId == conditionnement.Id);
                <tr class="@(conditionnement.Actif ? "" : "inactif")">
                    <td data-label="@L["Conditionnement"]">
                        <strong>@conditionnement.Libelle</strong> <small class="discret">@L[$"Niveau.{conditionnement.Niveau}"]</small>
                        @if (Session.A(Permissions.ArticlesGerer) && conditionnement.Actif)
                        {
                            @* Grille d'articles rapides de la caisse : choix du Gérant (articles sans code-barres, au poids…). *@
                            <label class="case" title="@L["VenteRapideAide"]">
                                <input type="checkbox" checked="@conditionnement.VenteRapide" @onchange="e => ChoisirVenteRapide(conditionnement.Id, e.Value is true)" />
                                @L["VenteRapide"]
                            </label>
                        }
                        else if (conditionnement.VenteRapide)
                        {
                            <Pastille Ton="Ton.Succes">@L["VenteRapide"]</Pastille>
                        }
                    </td>
                    <td data-label="@L["Contenu"]" class="nombre">@Format.Quantite(conditionnement.QuantiteUniteStock) @Format.Unite(_article.UniteStock)</td>
                    <td data-label="@L["Codes"]">
                        @foreach (var codeBarres in conditionnement.Codes.Where(c => c.Actif))
                        {
                            <div class="code">
                                <code>@codeBarres.Valeur</code>
                                @if (Session.A(Permissions.ArticlesGerer))
                                {
                                    <Bouton Variante="VarianteBouton.Discret" NomIcone="fermer" Libelle="@L["DesactiverCode"]" OnClick="() => DesactiverCode(codeBarres.Id)" />
                                }
                            </div>
                        }
                        @if (Session.A(Permissions.ArticlesGerer) && conditionnement.Actif)
                        {
                            <div class="code-ajout">
                                <input placeholder="@L["CodeBarresAide"]" aria-label="@L["CodeBarresAide"]" @bind="_nouveauxCodes[conditionnement.Id]" />
                                <Bouton Variante="VarianteBouton.Discret" NomIcone="ajouter" Desactive="_enCours" OnClick="() => AjouterCode(conditionnement.Id)">@L["Ajouter"]</Bouton>
                                <Bouton Variante="VarianteBouton.Discret" Desactive="_enCours" OnClick="() => GenererCode(conditionnement.Id)">@L["GenererCodeInterne"]</Bouton>
                            </div>
                        }
                    </td>
                    <td data-label="@L["PrixActuel"]" class="nombre">@(prix?.PrixTtc is { } p ? Format.Montant(p) : "—")</td>
                    <td data-label="@L["PrixProgramme"]">
                        @if (prix?.ProchainPrixTtc is { } prochain)
                        {
                            <span>@Format.Montant(prochain) <small class="discret">@L["ALaDate", prix.ProchaineValidite!.Value.ToString("d", CultureInfo.CurrentCulture)]</small></span>
                        }
                    </td>
                    <td>
                        @if (Session.A(Permissions.PrixGerer) && conditionnement.Actif)
                        {
                            <div class="code-ajout">
                                <input type="number" min="1" step="1" placeholder="@L["NouveauPrix"]" aria-label="@L["NouveauPrix"]" @bind="_nouveauxPrix[conditionnement.Id]" />
                                <input type="date" aria-label="@L["DebutValidite"]" @bind="_datesPrix[conditionnement.Id]" />
                                <Bouton Variante="VarianteBouton.Valider" Desactive="_enCours" OnClick="() => FixerPrix(conditionnement.Id)">@L["Fixer"]</Bouton>
                            </div>
                        }
                    </td>
                </tr>
            }
        </Corps>
    </Tableau>

    @if (Session.A(Permissions.StockConsulter))
    {
        <Tableau Titre="@L["DerniersMouvements"]" Colonnes="5" EstVide="_mouvements.Count == 0" TexteVide="@L["AucunMouvement"]" Legende="@L["DerniersMouvements"]">
            <Entete><th>@L["Date"]</th><th>@L["Mouvement"]</th><th>@L["Document"]</th><th class="nombre">@L["Quantite"]</th><th>@L["Utilisateur"]</th></Entete>
            <Corps>
                @foreach (var mouvement in _mouvements)
                {
                    <tr>
                        <td data-label="@L["Date"]" class="court">@Format.Date(mouvement.DateUtc)</td>
                        <td data-label="@L["Mouvement"]">@L[$"Mouvement.{mouvement.Type}"]</td>
                        <td data-label="@L["Document"]">@(mouvement.TypeDocument == "Reception" ? L["Reception"].Value : mouvement.TypeDocument)</td>
                        <td data-label="@L["Quantite"]" class="nombre @(mouvement.Variation < 0 ? "sortie" : "entree")">@(mouvement.Variation > 0 ? "+" : "")@Format.Quantite(mouvement.Variation, _article.PrecisionQuantite)</td>
                        <td data-label="@L["Utilisateur"]">@mouvement.Utilisateur</td>
                    </tr>
                }
            </Corps>
        </Tableau>
    }

    @if (Session.A(Permissions.ArticlesGerer))
    {
        <form class="fiche" @onsubmit="AjouterConditionnement">
            <h2>@L["NouveauConditionnement"]</h2>
            <div class="grille">
                <Champ Libelle="@L["Libelle"]" Requis="true"><input @bind="_libelle" required maxlength="50" placeholder="@L["ConditionnementExemple"]" /></Champ>
                <Champ Libelle="@L["Niveau"]">
                    <select @bind="_niveau">
                        @foreach (var niveau in new[] { "Pack", "Carton", "Sac", "Palette" })
                        {
                            <option value="@niveau">@L[$"Niveau.{niveau}"]</option>
                        }
                    </select>
                </Champ>
                <Champ Libelle="@($"{L["Contenu"]} ({Format.Unite(_article.UniteStock)})")" Requis="true"><input type="number" min="0" step="any" @bind="_facteur" required /></Champ>
            </div>
            <div class="actions"><Bouton Type="submit" Variante="VarianteBouton.Principal" NomIcone="ajouter" Occupe="_enCours">@L["Ajouter"]</Bouton></div>
        </form>
    }
}

@code {
    [Parameter] public Guid Id { get; set; }

    private Article? _article;
    private List<Conditionnement> _conditionnements = [];
    private List<PrixConditionnement> _prix = [];
    private Dictionary<Guid, string?> _nouveauxCodes = [];
    private Dictionary<Guid, decimal?> _nouveauxPrix = [];
    private Dictionary<Guid, DateOnly?> _datesPrix = [];
    private string _libelle = "";
    private string _niveau = "Carton";
    private decimal _facteur;
    private string? _erreur;
    private string? _succes;

    protected override Task OnParametersSetAsync() => Charger();

    private SoldeStock? _solde;
    private List<MouvementStock> _mouvements = [];

    private async Task Charger()
    {
        if (Session.A(Permissions.StockConsulter))
        {
            // Chiffres du stock et derniers mouvements (maquette A) : lus à part, la fiche reste utilisable sans eux.
            var soldes = await Api.GetAsync<List<SoldeStock>>($"api/stock/soldes?articles={Id}");
            var mouvements = await Api.GetAsync<List<MouvementStock>>($"api/stock/articles/{Id}/mouvements");
            _solde = soldes.Valeur?.FirstOrDefault(s => s.ArticleId == Id);
            _mouvements = [.. (mouvements.Valeur ?? []).OrderByDescending(m => m.DateUtc).Take(5)];
        }

        var article = await Api.GetAsync<Article>($"api/referentiel/articles/{Id}");
        _erreur = article.Erreur;
        _article = article.Valeur;
        var conditionnements = await Api.GetAsync<List<Conditionnement>>($"api/referentiel/articles/{Id}/conditionnements");
        var prix = await Api.GetAsync<List<PrixConditionnement>>($"api/prix/articles/{Id}");
        _erreur ??= conditionnements.Erreur ?? prix.Erreur;
        _conditionnements = conditionnements.Valeur ?? [];
        _prix = prix.Valeur ?? [];
        foreach (var conditionnement in _conditionnements)
        {
            _nouveauxCodes.TryAdd(conditionnement.Id, null);
            _nouveauxPrix.TryAdd(conditionnement.Id, null);
            _datesPrix.TryAdd(conditionnement.Id, null);
        }
    }

    private bool _enCours;

    /// <summary>Un seul envoi à la fois (boutons désactivés pendant l'appel) : un double clic n'ajoute rien deux fois.</summary>
    private async Task Executer<T>(Func<Task<Resultat<T>>> appel, string succes)
    {
        if (_enCours)
        {
            return;
        }

        _enCours = true;
        Resultat<T> resultat;
        try
        {
            resultat = await appel();
        }
        finally
        {
            _enCours = false;
        }

        _erreur = resultat.Erreur;
        _succes = resultat.Reussi ? succes : null;
        if (resultat.Reussi)
        {
            await Charger();
        }
    }

    private async Task AjouterConditionnement()
    {
        await Executer(() => Api.PostAsync<Conditionnement>($"api/referentiel/articles/{Id}/conditionnements", new { Libelle = _libelle, Niveau = _niveau, QuantiteUniteStock = _facteur }), L["ConditionnementAjoute"]);
        if (_erreur is null)
        {
            _libelle = "";
            _facteur = 0;
        }
    }

    private async Task AjouterCode(Guid conditionnement)
    {
        await Executer(() => Api.PostAsync<Conditionnement>($"api/referentiel/conditionnements/{conditionnement}/codes", new { Valeur = _nouveauxCodes[conditionnement] ?? "" }), L["CodeAjoute"]);
        if (_erreur is null)
        {
            _nouveauxCodes[conditionnement] = null;
        }
    }

    private Task ChoisirVenteRapide(Guid conditionnement, bool venteRapide) =>
        Executer(() => Api.PutAsync<Conditionnement>($"api/referentiel/conditionnements/{conditionnement}/vente-rapide", new { VenteRapide = venteRapide }),
            venteRapide ? L["VenteRapideAjoutee"] : L["VenteRapideRetiree"]);

    private Task GenererCode(Guid conditionnement) =>
        Executer(() => Api.PostAsync<Conditionnement>($"api/referentiel/conditionnements/{conditionnement}/codes/interne"), L["CodeAjoute"]);

    private async Task DesactiverCode(Guid code)
    {
        if (!await Confirmation.DemanderAsync(L["ConfirmerDesactivationCode"].Value, L["DesactiverCode"].Value, danger: true))
        {
            return;
        }

        await Executer(() => Api.PostAsync<Conditionnement>($"api/referentiel/codes/{code}/desactivation"), L["CodeDesactive"]);
    }

    private async Task FixerPrix(Guid conditionnement)
    {
        await Executer(() => Api.PostAsync<object>($"api/prix/conditionnements/{conditionnement}", new { PrixTtc = _nouveauxPrix[conditionnement] ?? 0, DebutValidite = _datesPrix[conditionnement] }), L["PrixFixe"]);
        if (_erreur is null)
        {
            _nouveauxPrix[conditionnement] = null;
            _datesPrix[conditionnement] = null;
        }
    }
}
