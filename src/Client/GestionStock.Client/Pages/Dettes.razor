@page "/dettes"
@inject Api Api

<PageTitle>@L["DettesFournisseurs"] · GestionStock</PageTitle>

<h1>@L["DettesFournisseurs"]</h1>
<p class="discret">@L["DettesIntro"]</p>

<div class="barre">
    <label class="case"><input type="checkbox" @bind="_nonSoldees" @bind:after="Charger" /> @L["SeulementNonSoldees"]</label>
</div>

<Message Texte="@_erreur" />

@if (_dettes is not null)
{
    <div class="tuiles">
        <div class="tuile chiffre"><span>@L["ResteDu"]</span><strong>@Format.Montant(_dettes.Fournisseurs.Sum(f => f.ResteDu))</strong></div>
        <div class="tuile chiffre"><span>@L["Fournisseurs"]</span><strong>@_dettes.Fournisseurs.Count</strong></div>
    </div>

    <h2>@L["ParFournisseur"]</h2>
    <table class="cartes">
        <thead><tr><th>@L["Fournisseur"]</th><th class="nombre">@L["Receptions"]</th><th class="nombre">@L["MontantDu"]</th><th class="nombre">@L["MontantPaye"]</th><th class="nombre">@L["ResteDu"]</th></tr></thead>
        <tbody>
            @foreach (var fournisseur in _dettes.Fournisseurs)
            {
                <tr>
                    <td data-label="@L["Fournisseur"]">@fournisseur.Fournisseur</td>
                    <td data-label="@L["Receptions"]" class="nombre">@fournisseur.NombreReceptions</td>
                    <td data-label="@L["MontantDu"]" class="nombre">@Format.Montant(fournisseur.MontantDu)</td>
                    <td data-label="@L["MontantPaye"]" class="nombre">@Format.Montant(fournisseur.MontantPaye)</td>
                    <td data-label="@L["ResteDu"]" class="nombre"><strong>@Format.Montant(fournisseur.ResteDu)</strong></td>
                </tr>
            }
            @if (!_charge)
            {
                <tr><td colspan="5"><Chargement /></td></tr>
            }
            else if (_dettes.Fournisseurs.Count == 0)
            {
                <tr><td colspan="5" class="vide">@L["AucuneDette"]</td></tr>
            }
        </tbody>
    </table>

    <h2>@L["ParReception"]</h2>
    <table class="cartes">
        <thead><tr><th>@L["Numero"]</th><th>@L["Date"]</th><th>@L["Fournisseur"]</th><th>@L["BonLivraison"]</th><th class="nombre">@L["MontantDu"]</th><th class="nombre">@L["MontantPaye"]</th><th class="nombre">@L["ResteDu"]</th><th>@L["Statut"]</th></tr></thead>
        <tbody>
            @foreach (var dette in _dettes.Receptions)
            {
                <tr>
                    <td data-label="@L["Numero"]" class="court"><a href="receptions/@dette.ReceptionId">@dette.Numero</a></td>
                    <td data-label="@L["Date"]" class="court">@Format.Date(dette.DateValidationUtc)</td>
                    <td data-label="@L["Fournisseur"]">@dette.Fournisseur</td>
                    <td data-label="@L["BonLivraison"]">@dette.NumeroBonLivraison</td>
                    <td data-label="@L["MontantDu"]" class="nombre">@Format.Montant(dette.MontantDu)</td>
                    <td data-label="@L["MontantPaye"]" class="nombre">@Format.Montant(dette.MontantPaye)</td>
                    <td data-label="@L["ResteDu"]" class="nombre">@Format.Montant(dette.ResteDu)</td>
                    <td data-label="@L["Statut"]"><Pastille Ton="@(dette.Statut == "Payee" ? Ton.Succes : Ton.Attention)">@L[$"StatutDette.{dette.Statut}"]</Pastille></td>
                </tr>
            }
            @if (!_charge)
            {
                <tr><td colspan="8"><Chargement /></td></tr>
            }
            else if (_dettes.Receptions.Count == 0)
            {
                <tr><td colspan="8" class="vide">@L["AucuneDette"]</td></tr>
            }
        </tbody>
    </table>
}

@code {
    // Premier chargement terminé : jusque-là, la liste montre l'attente et non « Aucun… ».
    private bool _charge;

    private ListeDettes? _dettes;
    private bool _nonSoldees = true;
    private string? _erreur;

    protected override Task OnInitializedAsync() => Charger();

    private async Task Charger()
    {
        var resultat = await Api.GetAsync<ListeDettes>($"api/achats/dettes?nonSoldees={_nonSoldees.ToString().ToLowerInvariant()}");
        _dettes = resultat.Valeur;
        _erreur = resultat.Erreur;
        _charge = true;
    }
}
