@page "/clients"
@inject Api Api
@implements IDisposable
@inject Session Session

<PageTitle>@L["Clients"] · GestionStock</PageTitle>

<h1>@L["Clients"]</h1>

<div class="barre">
    <input type="search" placeholder="@L["ChercherClient"]" @bind="_recherche" @bind:event="oninput" @bind:after="RechercherDiffere" />
    <label class="case"><input type="checkbox" @bind="_impayes" @bind:after="Charger" /> @L["SeulementImpayes"]</label>
    @if (Session.A(Permissions.ClientsGerer) && !_creation)
    {
        <button class="principal" @onclick="() => _creation = true">@L["NouveauClient"]</button>
    }
</div>

<Message Texte="@_erreur" />

@if (_creation)
{
    <form class="fiche" @onsubmit="Creer">
        <h2>@L["NouveauClient"]</h2>
        <div class="grille">
            <label>@L["Nom"] <input @bind="_nom" required maxlength="200" /></label>
            <label>@L["Telephone"] <input @bind="_telephone" required maxlength="30" placeholder="+237 6…" /></label>
            <label>@L["DelaiPaiement"] <input type="number" min="0" step="1" @bind="_delai" /></label>
        </div>
        <p class="discret">@L["DonneesPersonnellesAide"]</p>
        <div class="actions">
            <button type="submit" class="principal" disabled="@_enCours">@L["Enregistrer"]</button>
            <button type="button" @onclick="() => _creation = false">@L["Annuler"]</button>
        </div>
    </form>
}

<table class="cartes">
    <thead><tr><th>@L["Nom"]</th><th>@L["Telephone"]</th><th class="nombre">@L["Plafond"]</th><th class="nombre">@L["SoldeDu"]</th><th class="nombre">@L["EnRetard"]</th></tr></thead>
    <tbody>
        @foreach (var client in _clients)
        {
            <tr class="@(client.Actif ? "" : "inactif") @(client.MontantEnRetard > 0 ? "negatif" : "")">
                <td data-label="@L["Nom"]"><a href="clients/@client.Id">@client.Nom</a></td>
                <td data-label="@L["Telephone"]">@client.Telephone</td>
                <td data-label="@L["Plafond"]" class="nombre">@Format.Montant(client.PlafondCredit)</td>
                <td data-label="@L["SoldeDu"]" class="nombre">@Format.Montant(client.SoldeDu)</td>
                <td data-label="@L["EnRetard"]" class="nombre">@(client.MontantEnRetard > 0 ? Format.Montant(client.MontantEnRetard) : "")</td>
            </tr>
        }
        @if (!_charge)
        {
            <tr><td colspan="5"><Chargement /></td></tr>
        }
        else if (_clients.Count == 0)
        {
            <tr><td colspan="5" class="vide">@L["AucunClient"]</td></tr>
        }
    </tbody>
</table>
@if (_tronquee)
{
    <p class="discret">@L["ListeTronquee", TailleListe]</p>
}

@code {
    // Premier chargement terminé : jusque-là, la liste montre l'attente et non « Aucun… ».
    private bool _charge;

    private List<ClientCredit> _clients = [];
    private string _recherche = "";
    private bool _impayes;
    private bool _creation;
    private string _nom = "";
    private string _telephone = "";
    private int _delai = 30;
    private string? _erreur;
    private bool _enCours;

    protected override Task OnInitializedAsync() => Charger();

    private readonly RechercheDifferee _differee = new();

    private async Task RechercherDiffere()
    {
        if (await _differee.AttendreAsync() is { } numero)
        {
            await Charger(numero);
        }
    }

    private Task Charger() => Charger(null);

    /// <summary>Les <see cref="TailleListe"/> premiers clients (par nom) ; un de plus est demandé pour savoir s'il en reste.</summary>
    private async Task Charger(int? numero)
    {
        var url = _impayes ? "api/credit/impayes" : $"api/credit/clients?recherche={Uri.EscapeDataString(_recherche)}&taille={TailleListe + 1}";
        var resultat = await Api.GetAsync<List<ClientCredit>>(url);
        if (numero is { } n && !_differee.EstLaDerniere(n))
        {
            return;
        }

        _clients = resultat.Valeur ?? [];
        _tronquee = !_impayes && _clients.Count > TailleListe;
        _clients = [.. _clients.Take(TailleListe)];
        _erreur = resultat.Erreur;
        _charge = true;
    }

    private const int TailleListe = 200;
    private bool _tronquee;

    public void Dispose() => _differee.Dispose();

    private async Task Creer()
    {
        // Un seul envoi à la fois : un double clic ou une connexion lente ne crée pas deux fois la même chose.
        if (_enCours)
        {
            return;
        }

        _enCours = true;
        try
        {
            var resultat = await Api.PostAsync<ClientCredit>("api/credit/clients", new { Nom = _nom, Telephone = _telephone, DelaiPaiementJours = _delai });
            _erreur = resultat.Erreur;
            if (resultat.Reussi)
            {
                _creation = false;
                _nom = "";
                _telephone = "";
                await Charger();
            }
        }
        finally
        {
            _enCours = false;
        }
    }
}
