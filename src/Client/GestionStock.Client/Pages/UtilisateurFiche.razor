@page "/utilisateurs/{Id:guid}"
@inject Api Api
@inject Confirmation Confirmation
@inject NavigationManager Navigation

<PageTitle>@(_fiche?.Compte.NomComplet ?? L["Utilisateurs"]) · GestionStock</PageTitle>

<p><a href="utilisateurs"><Icone Nom="retour" />@L["Utilisateurs"]</a></p>
<Message Texte="@_erreur" />
<Message Texte="@_succes" Erreur="false" />

@if (_fiche is null && _erreur is null)
{
    <Chargement />
}
else if (_fiche is { Compte: var compte })
{
    <h1>@compte.NomComplet <small class="discret"><code>@compte.Matricule</code></small>
        <Pastille Ton="@(compte.Actif ? Ton.Succes : Ton.Neutre)">@(compte.Actif ? L["Actif"] : L["Desactive"])</Pastille>
    </h1>
    @if (compte.MotDePasseProvisoire)
    {
        <div class="message avertissement" role="status"><Icone Nom="attention" /><span>@L["MotDePasseProvisoireEnAttente"]</span></div>
    }

    <form class="fiche" @onsubmit="Enregistrer">
        <h2>@L["Fiche"]</h2>
        <div class="grille">
            <Champ Libelle="@L["Prenom"]" Requis="true"><input @bind="_prenom" required maxlength="100" /></Champ>
            <Champ Libelle="@L["Nom"]" Requis="true"><input @bind="_nom" required maxlength="100" /></Champ>
            <Champ Libelle="@L["Telephone"]"><input @bind="_telephone" maxlength="20" /></Champ>
            <Champ Libelle="@L["Langue"]">
                <select @bind="_langue">
                    <option value="fr">Français</option>
                    <option value="en">English</option>
                </select>
            </Champ>
        </div>
        <ChoixRoles Roles="_roles" />
        <p class="discret">@L["MatriculeFige"]</p>
        <div class="actions"><Bouton Type="submit" Variante="VarianteBouton.Principal" Occupe="_enCours">@L["Enregistrer"]</Bouton></div>
    </form>

    <div class="fiche">
        <h2>@L["MotDePasseOublie"]</h2>
        <p class="discret">@L["ReinitialisationAide"]</p>
        <div class="grille">
            <Champ Libelle="@L["MotDePasseProvisoire"]"><ChampMotDePasse @bind-Valeur="_provisoire" Autocomplete="new-password" /></Champ>
        </div>
        <div class="actions"><Bouton Desactive="@(_enCours || string.IsNullOrEmpty(_provisoire))" OnClick="Reinitialiser">@L["Reinitialiser"]</Bouton></div>
    </div>

    <div class="fiche">
        <h2>@L["Statut"]</h2>
        <p class="discret">@(compte.Actif ? L["DesactivationAide"] : L["ReactivationAide"])</p>
        <div class="actions">
            @if (compte.Actif)
            {
                <Bouton Variante="VarianteBouton.Danger" Desactive="_enCours" OnClick="Desactiver">@L["Desactiver"]</Bouton>
            }
            else
            {
                <Bouton Variante="VarianteBouton.Valider" NomIcone="valider" Desactive="_enCours" OnClick="Reactiver">@L["Reactiver"]</Bouton>
            }
        </div>
    </div>

    <h2>@L["JournalCompte"]</h2>
    <Tableau Colonnes="4" EstVide="_fiche.Journal.Count == 0" TexteVide="@L["AucuneOperation"]" Legende="@L["JournalCompte"]">
        <Entete><th>@L["Date"]</th><th>@L["Operation"]</th><th>@L["Auteur"]</th><th>@L["Detail"]</th></Entete>
        <Corps>
            @foreach (var ligne in _fiche.Journal)
            {
                <tr>
                    <td data-label="@L["Date"]" class="court">@Format.Date(ligne.DateUtc)</td>
                    <td data-label="@L["Operation"]">@L[$"ActionCompte.{ligne.Action}"]</td>
                    <td data-label="@L["Auteur"]">@ligne.Auteur</td>
                    <td data-label="@L["Detail"]">@ligne.Detail</td>
                </tr>
            }
        </Corps>
    </Tableau>
}

@code {
    [Parameter] public Guid Id { get; set; }

    private FicheCompte? _fiche;
    private string _prenom = "";
    private string _nom = "";
    private string? _telephone;
    private string _langue = "fr";
    private HashSet<string> _roles = [];
    private string? _provisoire;
    private bool _enCours;
    private string? _erreur;
    private string? _succes;

    protected override async Task OnParametersSetAsync()
    {
        var resultat = await Api.GetAsync<FicheCompte>($"api/identite/utilisateurs/{Id}");
        _erreur = resultat.Erreur;
        Afficher(resultat.Valeur);
        if (Navigation.Uri.Contains("cree=1", StringComparison.Ordinal) && _fiche is not null)
        {
            _succes = L["CompteCree", _fiche.Compte.Matricule].Value;
        }
    }

    private void Afficher(FicheCompte? fiche)
    {
        _fiche = fiche ?? _fiche;
        if (_fiche is { Compte: var c })
        {
            (_prenom, _nom, _telephone, _langue, _roles) = (c.Prenom, c.Nom, c.Telephone, c.Langue, [.. c.Roles]);
        }
    }

    private Task Enregistrer() => Executer(
        () => Api.PutAsync<FicheCompte>($"api/identite/utilisateurs/{Id}", new { Prenom = _prenom, Nom = _nom, Telephone = _telephone, Roles = _roles.ToList(), Langue = _langue }),
        "FicheEnregistree");

    private async Task Desactiver()
    {
        if (!await Confirmation.DemanderAsync(L["ConfirmerDesactivationCompte", _fiche?.Compte.NomComplet ?? ""].Value, L["Desactiver"].Value, danger: true))
        {
            return;
        }

        await Executer(() => Api.PostAsync<FicheCompte>($"api/identite/utilisateurs/{Id}/desactivation"), "CompteDesactive");
    }

    private Task Reactiver() => Executer(() => Api.PostAsync<FicheCompte>($"api/identite/utilisateurs/{Id}/reactivation"), "CompteReactive");

    private async Task Reinitialiser()
    {
        if (!await Confirmation.DemanderAsync(L["ConfirmerReinitialisation", _fiche?.Compte.NomComplet ?? ""].Value, L["Reinitialiser"].Value))
        {
            return;
        }

        await Executer(() => Api.PostAsync<FicheCompte>($"api/identite/utilisateurs/{Id}/mot-de-passe", new { MotDePasse = _provisoire }), "MotDePasseReinitialise");
        if (_erreur is null)
        {
            _provisoire = null;
        }
    }

    private async Task Executer(Func<Task<Resultat<FicheCompte>>> action, string cleSucces)
    {
        _enCours = true;
        _succes = null;
        var resultat = await action();
        _enCours = false;
        _erreur = resultat.Erreur;
        if (resultat.Valeur is not null)
        {
            _succes = L[cleSucces].Value;
        }

        Afficher(resultat.Valeur);
    }
}
