@page "/caisse/tickets"
@using System.Globalization
@inject Api Api
@inject NavigationManager Navigation
@inject CaisseHorsLigne HorsLigne

<PageTitle>@L["TicketsDuJour"] · GestionStock</PageTitle>

<p><a href="caisse"><Icone Nom="retour" />@L["RetourCaisse"]</a></p>
<h1>@L["TicketsDuJour"]</h1>

<form class="barre" role="search" @onsubmit="ChercherNumero">
    <input placeholder="@L["NumeroTicketAide"]" aria-label="@L["NumeroTicketAide"]" @bind="_numero" />
    <Bouton Type="submit" NomIcone="rechercher">@L["Rechercher"]</Bouton>
</form>

<Message Texte="@_erreur" />

@if (_charge && _tickets.Count > 0)
{
    @* Résumé de la session : ventes, avoirs et total net, comme au ticket de clôture. *@
    <div class="indicateurs resume">
        <Indicateur Libelle="@L["Tickets"]" Valeur="@_tickets.Count(t => !t.EstAvoir).ToString(CultureInfo.CurrentCulture)" />
        <Indicateur Libelle="@L["Avoirs"]" Valeur="@_tickets.Count(t => t.EstAvoir).ToString(CultureInfo.CurrentCulture)"
                    Ton="@(_tickets.Any(t => t.EstAvoir) ? Ton.Attention : Ton.Neutre)" />
        <Indicateur Libelle="@L["Ventes"]" Valeur="@Format.Montant(_tickets.Sum(t => t.EstAvoir ? -t.TotalTtc : t.TotalTtc))" />
    </div>
}

<Tableau Colonnes="5" Charge="_charge" EstVide="_tickets.Count == 0" TexteVide="@L["AucunTicket"]" Legende="@L["TicketsDuJour"]">
    <Entete><th>@L["Numero"]</th><th>@L["Date"]</th><th class="nombre">@L["Total"]</th><th>@L["Paiements"]</th><th></th></Entete>
    <Corps>
        @foreach (var ticket in _tickets)
        {
            <tr>
                <td data-label="@L["Numero"]" class="court"><a href="caisse/tickets/@ticket.Id"><code>@ticket.Numero</code></a></td>
                <td data-label="@L["Date"]" class="court">@Format.Date(ticket.DateUtc)</td>
                <td data-label="@L["Total"]" class="nombre">@(ticket.EstAvoir ? "-" : "")@Format.Montant(ticket.TotalTtc)</td>
                <td data-label="@L["Paiements"]">@string.Join(", ", ticket.Paiements.Select(p => L[$"Mode.{p.Mode}"].Value))</td>
                <td>@if (ticket.EstAvoir) { <Pastille Ton="Ton.Attention">@L["Avoir"]</Pastille> }</td>
            </tr>
        }
    </Corps>
</Tableau>

@code {
    // Premier chargement terminé : jusque-là, la liste montre l'attente et non « Aucun… ».
    private bool _charge;

    private List<TicketCaisse> _tickets = [];
    private string _numero = "";
    private string? _erreur;

    protected override async Task OnInitializedAsync()
    {
        var session = await Api.GetAsync<SessionCaisse>("api/caisse/sessions/courante");
        if (session.Code == Api.CodeHorsLigne)
        {
            // Hors ligne (7.8) : tickets de la session gardés sur le poste, y compris ceux pas encore envoyés.
            _tickets = await HorsLigne.SessionGardeeAsync() is { } gardee ? await HorsLigne.TicketsAsync(gardee.Id) : [];
            _charge = true;
            return;
        }

        _erreur = session.Erreur;
        if (session.Valeur is { } courante)
        {
            _tickets = (await Api.GetAsync<List<TicketCaisse>>($"api/caisse/sessions/{courante.Id}/tickets")).Valeur ?? [];
        }
        _charge = true;
    }

    private async Task ChercherNumero()
    {
        var resultat = await Api.GetAsync<TicketCaisse>($"api/caisse/tickets/numero/{Uri.EscapeDataString(_numero.Trim())}");
        _erreur = resultat.Erreur;
        if (resultat.Valeur is { } ticket)
        {
            Navigation.NavigateTo($"caisse/tickets/{ticket.Id}");
        }
    }
}
