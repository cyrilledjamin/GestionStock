@page "/exports"
@inject Api Api
@inject IJSRuntime Js

<PageTitle>@L["Exports"] · GestionStock</PageTitle>

<h1>@L["Exports"]</h1>
<p class="discret">@L["ExportsIntro"]</p>

<div class="fiche">
    <div class="grille">
        <Champ Libelle="@L["Journal"]">
            <select @bind="_journal">
                @foreach (var journal in JournauxComptables.Tous)
                {
                    <option value="@journal">@L[$"Journal.{journal}"]</option>
                }
            </select>
        </Champ>
        @if (_journal != "valeur-stock")
        {
            <Champ Libelle="@L["Du"]"><input type="date" @bind="_du" /></Champ>
            <Champ Libelle="@L["Au"]"><input type="date" @bind="_au" /></Champ>
        }
        <Champ Libelle="@L["Format"]">
            <select @bind="_format">
                <option value="xlsx">Excel (.xlsx)</option>
                <option value="csv">CSV (;)</option>
            </select>
        </Champ>
    </div>
    <div class="message info" role="status"><Icone Nom="info" /><span>@L[$"JournalAide.{_journal}"]</span></div>
    <div class="actions">
        <Bouton Variante="VarianteBouton.Principal" NomIcone="telecharger" Occupe="_enCours" OnClick="Telecharger">@L["Telecharger"]</Bouton>
    </div>
</div>

<Message Texte="@_erreur" />

@code {
    private string _journal = "ventes";
    private string _format = "xlsx";
    private DateOnly _du = new(DateTime.UtcNow.AddHours(1).Year, DateTime.UtcNow.AddHours(1).Month, 1);
    private DateOnly _au = DateOnly.FromDateTime(DateTime.UtcNow.AddHours(1));
    private string? _erreur;
    private bool _enCours;

    private async Task Telecharger()
    {
        if (_enCours)
        {
            return;
        }

        _enCours = true;
        byte[]? octets;
        try
        {
            octets = await Api.GetOctetsAsync($"api/exports/{_journal}?du={_du:yyyy-MM-dd}&au={_au:yyyy-MM-dd}&format={_format}");
        }
        finally
        {
            _enCours = false;
        }

        _erreur = octets is null ? L["ExportImpossible"].Value : null;
        if (octets is not null)
        {
            var nom = _journal == "valeur-stock" ? $"{_journal}-{_au:yyyy-MM-dd}.{_format}" : $"{_journal}-{_du:yyyy-MM-dd}-{_au:yyyy-MM-dd}.{_format}";
            var type = _format == "csv" ? "text/csv" : "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet";
            await Js.InvokeVoidAsync("gestionStock.telecharger", nom, type, Convert.ToBase64String(octets));
        }
    }
}
