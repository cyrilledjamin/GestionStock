@page "/mon-compte"
@inject Session Session
@inject NavigationManager Navigation

<PageTitle>@L["MonCompte"] · GestionStock</PageTitle>

<h1>@L["MonCompte"]</h1>

@if (Session.DoitChangerMotDePasse)
{
    <div class="message avertissement" role="alert"><Icone Nom="attention" /><span>@L["ChangerMotDePasseObligatoire"]</span></div>
}
<Message Texte="@_erreur" />
<Message Texte="@_succes" Erreur="false" />

@if (Session.Profil is { } profil)
{
    <div class="fiche">
        <dl class="grille">
            <div><dt>@L["Nom"]</dt><dd>@profil.NomComplet</dd></div>
            <div><dt>@L["Matricule"]</dt><dd><code>@profil.Identifiant</code></dd></div>
            <div><dt>@L["Roles"]</dt><dd>@string.Join(", ", profil.Roles.Select(r => L[$"Role.{r}"].Value))</dd></div>
            <div><dt>@L["Langue"]</dt><dd>@(profil.Langue == "en" ? "English" : "Français")</dd></div>
        </dl>
        <div class="message info" role="status"><Icone Nom="info" /><span>@L["FicheParAdministrateur"]</span></div>
    </div>

    <form class="fiche" @onsubmit="Changer">
        <h2>@L["ChangerMotDePasse"]</h2>
        <div class="grille">
            <Champ Libelle="@L["MotDePasseActuel"]" Requis="true"><ChampMotDePasse @bind-Valeur="_actuel" Requis="true" Autocomplete="current-password" /></Champ>
            <Champ Libelle="@L["NouveauMotDePasse"]" Requis="true"><ChampMotDePasse @bind-Valeur="_nouveau" Requis="true" Autocomplete="new-password" /></Champ>
            <Champ Libelle="@L["ConfirmerMotDePasse"]" Requis="true"><ChampMotDePasse @bind-Valeur="_confirmation" Requis="true" Autocomplete="new-password" /></Champ>
        </div>
        <div class="message info" role="status"><Icone Nom="info" /><span>@L["MotDePasseRegle"]</span></div>
        <div class="actions"><Bouton Type="submit" Variante="VarianteBouton.Principal" Occupe="_enCours">@L["ChangerMotDePasse"]</Bouton></div>
    </form>
}

@code {
    private string _actuel = "";
    private string _nouveau = "";
    private string _confirmation = "";
    private bool _enCours;
    private string? _erreur;
    private string? _succes;

    private async Task Changer()
    {
        _succes = null;
        if (_nouveau != _confirmation)
        {
            _erreur = L["ConfirmationDifferente"].Value;
            return;
        }

        if (_enCours)
        {
            return;
        }

        var etaitProvisoire = Session.DoitChangerMotDePasse;
        _enCours = true;
        try
        {
            _erreur = await Session.ChangerMotDePasseAsync(_actuel, _nouveau);
        }
        finally
        {
            _enCours = false;
        }

        if (_erreur is null)
        {
            (_actuel, _nouveau, _confirmation) = ("", "", "");
            if (etaitProvisoire)
            {
                Navigation.NavigateTo("");
                return;
            }

            _succes = L["MotDePasseChange"].Value;
        }
    }
}
