@page "/clients/{Id:guid}"
@inject Api Api
@inject Session Session

<PageTitle>@(_fiche?.Client.Nom ?? L["Clients"]) · GestionStock</PageTitle>

<p><a href="clients"><Icone Nom="retour" />@L["Clients"]</a></p>
<Message Texte="@_erreur" />
<Message Texte="@_succes" Erreur="false" />

@if (_fiche is null && _erreur is null)
{
    <Chargement />
}
else if (_fiche is { Client: var client })
{
    <h1>@client.Nom</h1>
    <p class="discret">@client.Telephone · @L["DelaiPaiement"] : @client.DelaiPaiementJours</p>

    <div class="indicateurs resume">
        <Indicateur Libelle="@L["SoldeDu"]" Valeur="@Format.Montant(client.SoldeDu)" Ton="@(client.SoldeDu > client.PlafondCredit ? Ton.Danger : Ton.Neutre)" />
        <Indicateur Libelle="@L["Plafond"]" Valeur="@Format.Montant(client.PlafondCredit)" />
        <Indicateur Libelle="@L["EnRetard"]" Valeur="@Format.Montant(client.MontantEnRetard)" Ton="@(client.MontantEnRetard > 0 ? Ton.Danger : Ton.Neutre)" />
    </div>

    @if (Session.A(Permissions.PlafondsGerer))
    {
        <form class="barre" @onsubmit="FixerPlafond">
            <Champ Libelle="@L["Plafond"]"><input type="number" min="0" step="1" @bind="_plafond" /></Champ>
            <Bouton Type="submit" Variante="VarianteBouton.Principal" Occupe="_enCours">@L["Fixer"]</Bouton>
        </form>
    }

    <h2>@L["VentesNonSoldees"]</h2>
    <Tableau Colonnes="5" EstVide="_fiche.VentesOuvertes.Count == 0" TexteVide="@L["AucuneDette"]" Legende="@L["VentesNonSoldees"]">
        <Entete><th>@L["Ticket"]</th><th>@L["Date"]</th><th>@L["Echeance"]</th><th class="nombre">@L["Montant"]</th><th class="nombre">@L["ResteDu"]</th></Entete>
        <Corps>
            @foreach (var vente in _fiche.VentesOuvertes)
            {
                <tr class="@(vente.EnRetard ? "negatif" : "")">
                    <td data-label="@L["Ticket"]" class="court"><a href="caisse/tickets/@vente.TicketId"><code>@vente.NumeroTicket</code></a></td>
                    <td data-label="@L["Date"]" class="court">@Format.Date(vente.DateUtc)</td>
                    <td data-label="@L["Echeance"]" class="court">@Format.Date(vente.EcheanceUtc) @if (vente.EnRetard) { <Pastille Ton="Ton.Danger">@L["EnRetard"]</Pastille> }</td>
                    <td data-label="@L["Montant"]" class="nombre">@Format.Montant(vente.Montant)</td>
                    <td data-label="@L["ResteDu"]" class="nombre">@Format.Montant(vente.ResteDu)</td>
                </tr>
            }
        </Corps>
    </Tableau>

    <h2>@L["Journal"]</h2>
    <Tableau Colonnes="5" EstVide="_fiche.Operations.Count == 0" TexteVide="@L["AucuneOperation"]" Legende="@L["Journal"]">
        <Entete><th>@L["Date"]</th><th>@L["Operation"]</th><th class="nombre">@L["Montant"]</th><th>@L["Utilisateur"]</th><th>@L["ValideePar"]</th></Entete>
        <Corps>
            @foreach (var operation in _fiche.Operations)
            {
                <tr>
                    <td data-label="@L["Date"]" class="court">@Format.Date(operation.DateUtc)</td>
                    <td data-label="@L["Operation"]">@L[$"Operation.{operation.Type}"] @operation.NumeroTicket</td>
                    <td data-label="@L["Montant"]" class="nombre">@Format.Montant(operation.Montant)</td>
                    <td data-label="@L["Utilisateur"]">@Format.Personne(_fiche.Personnel, operation.Utilisateur)</td>
                    <td data-label="@L["ValideePar"]">@Format.Personne(_fiche.Personnel, operation.ValideePar)</td>
                </tr>
            }
        </Corps>
    </Tableau>
}

@code {
    [Parameter] public Guid Id { get; set; }

    private FicheClient? _fiche;
    private decimal _plafond;
    private string? _erreur;
    private string? _succes;

    protected override Task OnParametersSetAsync() => Charger();

    private async Task Charger()
    {
        var resultat = await Api.GetAsync<FicheClient>($"api/credit/clients/{Id}");
        _erreur = resultat.Erreur;
        _fiche = resultat.Valeur;
        _plafond = _fiche?.Client.PlafondCredit ?? 0;
    }

    private bool _enCours;

    private async Task FixerPlafond()
    {
        if (_enCours)
        {
            return;
        }

        _enCours = true;
        Resultat<ClientCredit> resultat;
        try
        {
            resultat = await Api.PutAsync<ClientCredit>($"api/credit/clients/{Id}/plafond", new { PlafondCredit = _plafond });
        }
        finally
        {
            _enCours = false;
        }

        _erreur = resultat.Erreur;
        _succes = resultat.Reussi ? L["PlafondFixe"].Value : null;
        await Charger();
    }
}
