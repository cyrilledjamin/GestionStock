@page "/anomalies"
@inject Api Api
@inject Session Session

<PageTitle>@L["Anomalies"] · GestionStock</PageTitle>

<h1>@L["Anomalies"]</h1>
<p class="discret">@L["AnomaliesAide"]</p>

<div class="barre">
    <select @bind="_filtre" @bind:after="Charger" aria-label="@L["Statut"]">
        <option value="false">@L["ATraiter"]</option>
        <option value="true">@L["Traitees"]</option>
        <option value="">@L["Toutes"]</option>
    </select>
</div>

<Message Texte="@_erreur" />
<Message Texte="@_succes" Erreur="false" />

<Tableau Colonnes="7" Charge="_charge" EstVide="_anomalies.Count == 0" TexteVide="@L["AucuneAnomalie"]" Legende="@L["Anomalies"]">
    <Entete><th>@L["Anomalie"]</th><th>@L["Date"]</th><th>@L["Poste"]</th><th>@L["Caissier"]</th><th>@L["Document"]</th><th>@L["Detail"]</th><th>@L["Traitement"]</th></Entete>
    <Corps>
        @foreach (var anomalie in _anomalies)
        {
            <tr class="@(anomalie.Traitee ? "inactif" : "")">
                <td data-label="@L["Anomalie"]">
                    <strong>@L[$"Anomalie.{anomalie.Type}"]</strong><br />
                    <small class="discret">@L[$"AnomalieAide.{anomalie.Type}"]</small>
                </td>
                <td data-label="@L["Date"]" class="court">@Format.Date(anomalie.DateUtc)</td>
                <td data-label="@L["Poste"]">@anomalie.NumeroCaisse</td>
                <td data-label="@L["Caissier"]">@(anomalie.NomCaissier ?? anomalie.Caissier)</td>
                <td data-label="@L["Document"]">@anomalie.NumeroDocument</td>
                <td data-label="@L["Detail"]"><code>@anomalie.Detail</code></td>
                <td data-label="@L["Traitement"]">
                    @if (anomalie.Traitee)
                    {
                        <Pastille Ton="Ton.Succes">@L["Traitee"]</Pastille>
                        <span>@anomalie.Commentaire</span><br /><small class="discret">@(anomalie.NomTraiteePar ?? anomalie.TraiteePar) · @(anomalie.TraitementUtc is { } le ? Format.Date(le) : "")</small>
                    }
                    else if (Session.A(Permissions.AnomaliesTraiter))
                    {
                        <form class="traitement" @onsubmit="() => Traiter(anomalie)">
                            <input placeholder="@L["CommentaireTraitement"]" aria-label="@L["CommentaireTraitement"]" maxlength="500" @bind="_commentaires[anomalie.Id]" required />
                            <Bouton Type="submit" Variante="VarianteBouton.Valider" NomIcone="valider" Occupe="_envoi == anomalie.Id">@L["Traiter"]</Bouton>
                        </form>
                    }
                    else
                    {
                        <Pastille Ton="Ton.Attention">@L["ATraiter"]</Pastille>
                    }
                </td>
            </tr>
        }
    </Corps>
</Tableau>

@code {
    // Premier chargement terminé : jusque-là, la liste montre l'attente et non « Aucun… ».
    private bool _charge;

    private List<AnomalieCaisse> _anomalies = [];
    private Dictionary<Guid, string?> _commentaires = [];
    private string _filtre = "false";
    private string? _erreur;
    private string? _succes;
    private Guid? _envoi;

    protected override Task OnInitializedAsync() => Charger();

    private async Task Charger()
    {
        var url = _filtre.Length == 0 ? "api/caisse/anomalies" : $"api/caisse/anomalies?traitees={_filtre}";
        var resultat = await Api.GetAsync<List<AnomalieCaisse>>(url);
        _anomalies = resultat.Valeur ?? [];
        _erreur = resultat.Erreur;
        foreach (var anomalie in _anomalies)
        {
            _commentaires.TryAdd(anomalie.Id, null);
        }
        _charge = true;
    }

    /// <summary>Traitement par le Gérant (7.8) : un commentaire dit ce qui a été fait ; l'anomalie reste dans l'historique.</summary>
    private async Task Traiter(AnomalieCaisse anomalie)
    {
        if (_envoi is not null)
        {
            return;
        }

        _envoi = anomalie.Id;
        Resultat<AnomalieCaisse> resultat;
        try
        {
            resultat = await Api.PostAsync<AnomalieCaisse>($"api/caisse/anomalies/{anomalie.Id}/traitement", new { Commentaire = _commentaires[anomalie.Id] });
        }
        finally
        {
            _envoi = null;
        }

        _erreur = resultat.Erreur;
        _succes = resultat.Reussi ? L["AnomalieTraitee"].Value : null;
        if (resultat.Reussi)
        {
            await Charger();
        }
    }
}
