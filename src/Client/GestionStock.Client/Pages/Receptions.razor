@page "/receptions"
@inject Api Api
@inject Session Session

<PageTitle>@L["Receptions"] · GestionStock</PageTitle>

<h1>@L["Receptions"]</h1>

<div class="barre">
    @if (Session.A(Permissions.ReceptionsSaisir))
    {
        <a class="bouton principal" href="receptions/nouvelle"><Icone Nom="ajouter" />@L["NouvelleReception"]</a>
    }
</div>

<Message Texte="@_erreur" />

<Tableau Colonnes="7" Charge="_charge" EstVide="_receptions.Count == 0" TexteVide="@L["AucuneReception"]" Legende="@L["Receptions"]">
    <Entete>
        <th>@L["Numero"]</th><th>@L["Date"]</th><th>@L["Fournisseur"]</th><th>@L["BonLivraison"]</th><th class="nombre">@L["Lignes"]</th><th class="nombre">@L["Valeur"]</th><th>@L["Statut"]</th>
    </Entete>
    <Corps>
        @foreach (var reception in _receptions)
        {
            <tr>
                <td data-label="@L["Numero"]" class="court"><a href="receptions/@reception.Id"><code>@reception.Numero</code></a></td>
                <td data-label="@L["Date"]" class="court">@Format.Date(reception.DateValidationUtc ?? reception.DateCreationUtc)</td>
                <td data-label="@L["Fournisseur"]">@reception.Fournisseur</td>
                <td data-label="@L["BonLivraison"]" class="court">@reception.NumeroBonLivraison</td>
                <td data-label="@L["Lignes"]" class="nombre">@reception.NombreLignes</td>
                <td data-label="@L["Valeur"]" class="nombre">@Format.Montant(reception.Valeur)</td>
                <td data-label="@L["Statut"]"><Pastille Ton="@TonStatut(reception.Statut)">@L[$"Statut.{reception.Statut}"]</Pastille></td>
            </tr>
        }
    </Corps>
</Tableau>

@code {
    // Premier chargement terminé : jusque-là, la liste montre l'attente et non « Aucun… ».
    private bool _charge;

    private List<ResumeReception> _receptions = [];
    private string? _erreur;

    /// <summary>Brouillon : reste à valider (orange) ; validée : marchandise entrée en stock (vert).</summary>
    internal static Ton TonStatut(string statut) => statut == "Validee" ? Ton.Succes : Ton.Attention;

    protected override async Task OnInitializedAsync()
    {
        var resultat = await Api.GetAsync<List<ResumeReception>>("api/achats/receptions");
        _receptions = resultat.Valeur ?? [];
        _erreur = resultat.Erreur;
        _charge = true;
    }
}
