    private async Task Encaisser()
    {
        if (!Connexion.EnLigne)
        {
            await EncaisserHorsLigne();
            return;
        }

        _enCours = true;
        var demande = new
        {
            IdIdempotence = _idIdempotence,
            ClientId = _client?.Id,
            Lignes = _vente.Lignes.Select(l => new { l.Vendable.ConditionnementId, l.Quantite, l.Remise, l.Vendable.CodeScanne }).ToList(),
            Paiements = _vente.Paiements.Where(p => p.Montant > 0).Select(p => new { p.Mode, p.Montant, p.Reference }).ToList(),
            Validation = string.IsNullOrWhiteSpace(_validationIdentifiant) ? null : new { Identifiant = _validationIdentifiant, MotDePasse = _validationMotDePasse },
        };
        var resultat = await Api.PostAsync<TicketCaisse>("api/caisse/tickets", demande);
        _enCours = false;
        if (resultat.Code == Api.CodeHorsLigne)
        {
            await EncaisserHorsLigne();
            return;
        }

        _erreur = resultat.Erreur;
        _validationNecessaire |= resultat.Code is "Caisse.PlafondDepasse" or "Caisse.RemiseNonValidee" or "Caisse.ValidationRefusee";
        _validationMotDePasse = "";
        if (resultat.Valeur is { } ticket)
        {
            _dernierTicket = ticket;
            _focaliserNouvelleVente = true;
            await HorsLigne.NoterNumeroAsync(_session!.NumeroCaisse, TicketLocal.Rang(ticket.Numero));
            await HorsLigne.GarderTicketAsync(_session.Id, ticket);
            await ActualiserSession();
        }
    }

    /// <summary>
    /// Vente sans serveur (7.8) : contrôles que le serveur ferait (paiement, rendu en espèces, référence Mobile Money),
    /// remise et dépassement de plafond refusés (décision 39), plafond lu sur le dernier solde connu moins le crédit
    /// déjà en file ; puis numéro du poste, mise en file, et seulement ensuite le reçu.
    /// </summary>
    private async Task EncaisserHorsLigne()
    {
        _erreur = ControleHorsLigne();
        if (_erreur is not null || _session is not { } session)
        {
            return;
        }

        var maintenant = DateTime.UtcNow;
        var numero = TicketLocal.Numero(session.NumeroCaisse, await HorsLigne.ProchainNumeroAsync(session.NumeroCaisse));
        var ticket = TicketLocal.Vente(_vente, _idIdempotence, numero, maintenant, Session.Profil!.Identifiant,
            $"{Session.Profil.NomComplet} ({Session.Profil.Identifiant})", _client?.Id, await TauxTvaAsync());
        var corps = new
        {
            IdIdempotence = _idIdempotence,
            ClientId = _client?.Id,
            Lignes = _vente.Lignes.Select(l => new { l.Vendable.ConditionnementId, l.Quantite, l.Remise, l.Vendable.CodeScanne, PrixUnitaire = l.Prix }).ToList(),
            Paiements = _vente.Paiements.Where(p => p.Montant > 0).Select(p => new { p.Mode, p.Montant, p.Reference }).ToList(),
            HorsLigne = new { SessionId = session.Id, Numero = TicketLocal.Rang(numero), DateUtc = maintenant },
        };
        await HorsLigne.AjouterAsync(new OperationEnAttente(
            CaisseHorsLigne.NouvelleCle(), OperationEnAttente.Vente, _idIdempotence, Session.Profil.Identifiant, session.Id, "api/caisse/tickets",
            System.Text.Json.JsonSerializer.SerializeToElement(corps, System.Text.Json.JsonSerializerOptions.Web), _client?.Id,
            _vente.Paiements.Where(p => p.Mode == ModesPaiement.Credit).Sum(p => p.Montant), $"{numero} · {Format.Montant(ticket.TotalTtc)}", maintenant));
        await HorsLigne.GarderTicketAsync(session.Id, ticket);
        _session = session with { Totaux = session.Totaux with { NombreVentes = session.Totaux.NombreVentes + 1, Ventes = session.Totaux.Ventes + ticket.TotalTtc } };
        _dernierTicket = ticket;
        _focaliserNouvelleVente = true;
    }

    /// <summary>Contrôles du serveur faits sur le poste : une vente mise en file ne doit pas être refusée au retour du réseau.</summary>
    private string? ControleHorsLigne()
    {
        if (_vente.Lignes.Any(l => l.Remise > 0) || !string.IsNullOrWhiteSpace(_validationIdentifiant))
        {
            return L["RemiseHorsLigne"];
        }

        var paye = _vente.Paiements.Where(p => p.Montant > 0).ToList();
        if (paye.Sum(p => p.Montant) < _vente.Total)
        {
            return L["ResteAPayer"] + " : " + Format.Montant(_vente.Reste);
        }

        if (paye.Sum(p => p.Montant) - _vente.Total > paye.Where(p => p.Mode == ModesPaiement.Especes).Sum(p => p.Montant))
        {
            return L["RenduSansEspeces"];
        }

        if (paye.Any(p => p.Mode == ModesPaiement.MobileMoney && string.IsNullOrWhiteSpace(p.Reference)))
        {
            return L["ReferenceMobileMoney"];
        }

        var credit = paye.Where(p => p.Mode == ModesPaiement.Credit).Sum(p => p.Montant);
        if (credit > 0)
        {
            var client = _client is null ? null : Cache.Clients.FirstOrDefault(c => c.Id == _client.Id) ?? _client;
            if (client is null || credit > PlafondHorsLigne.Disponible(client, HorsLigne.EnAttente))
            {
                return L["PlafondHorsLigne"];
            }
        }

        return null;
    }

    /// <summary>Taux de TVA appliqué (régime de l'entreprise, RG37), lu dans la grille gardée sur le poste.</summary>
    private async Task<decimal> TauxTvaAsync()
    {
        var grille = await Stockage.LireAsync<GrillePrix>(StockageLocal.Cache, "grille");
        return grille is { Assujetti: true } ? grille.TauxTva : 0m;
    }

    private void NouvelleVente()
    {
        _dernierTicket = null;
        _vente = new VenteEnCours();
        _ligneChoisie = null;
        _remiseOuverte = null;
        _cible = CiblePave.Especes;
        _client = null;
        _idIdempotence = Guid.NewGuid();
        _validationNecessaire = false;
        _validationIdentifiant = "";
        _erreur = null;
        _focaliserScan = true;
    }

    private async Task CloturerAsync()
    {
        await HorsLigne.SynchroniserAsync();
        if (!Connexion.EnLigne || HorsLigne.EnAttente.Count > 0)
        {
            _erreur = L["ClotureAttendSynchro", HorsLigne.EnAttente.Count];
            return;
        }

        var dernier = await HorsLigne.DernierNumeroAsync(_session!.NumeroCaisse);
        var resultat = await Api.PostAsync<SessionCaisse>("api/caisse/sessions/courante/cloture", new { EspecesComptees = _especesComptees, DernierNumero = dernier > 0 ? dernier : (long?)null });
        _erreur = resultat.Erreur;
        if (resultat.Valeur is { } session)
        {
            _panneau = Panneau.Aucun;
            _session = null;
            _erreur = null;
            _especesComptees = 0;
            _succes = L["SessionCloturee", Format.Montant(session.Totaux.EspecesTheoriques), Format.Montant(session.Ecart ?? 0)];
            await ChargerOccupations();
        }
    }

    private async Task Rembourser()
    {
        if (_remboursementEnCours)
        {
            return;
        }

        _remboursementEnCours = true;
        try
        {
            var idIdempotence = _idRemboursement;
            var demande = new
            {
                IdIdempotence = idIdempotence,
                ClientId = _clientRemboursement!.Id,
                Mode = _modeRemboursement,
                Montant = _montantRemboursement,
                Reference = _referenceRemboursement,
            };
            var resultat = Connexion.EnLigne
                ? await Api.PostAsync<RemboursementCredit>("api/caisse/remboursements", demande)
                : new Resultat<RemboursementCredit>(default, null, Api.CodeHorsLigne);
            if (resultat.Code == Api.CodeHorsLigne && _session is { } session)
            {
                // Hors ligne (7.8) : le remboursement part avec la file ; il diminue déjà la dette connue du poste.
                var maintenant = DateTime.UtcNow;
                await HorsLigne.AjouterAsync(new OperationEnAttente(
                    CaisseHorsLigne.NouvelleCle(), OperationEnAttente.Remboursement, idIdempotence, Session.Profil!.Identifiant, session.Id, "api/caisse/remboursements",
                    System.Text.Json.JsonSerializer.SerializeToElement(new { demande.IdIdempotence, demande.ClientId, demande.Mode, demande.Montant, demande.Reference, HorsLigne = new { SessionId = session.Id, Numero = (long?)null, DateUtc = maintenant } }, System.Text.Json.JsonSerializerOptions.Web),
                    _clientRemboursement.Id, -_montantRemboursement, $"{_clientRemboursement.Nom} · {Format.Montant(_montantRemboursement)}", maintenant));
                _idRemboursement = Guid.NewGuid();
                _succes = L["RemboursementEnAttente", Format.Montant(_montantRemboursement), _clientRemboursement.Nom];
                _erreur = null;
                _panneau = Panneau.Aucun;
                _clientRemboursement = null;
                _montantRemboursement = 0;
                _referenceRemboursement = null;
                return;
            }

            _erreur = resultat.Erreur;
            if (resultat.Valeur is { } remboursement)
            {
                _idRemboursement = Guid.NewGuid();
                _succes = L["RemboursementEnregistre", Format.Montant(remboursement.Montant), Format.Montant(remboursement.SoldeDuApres)];
                _panneau = Panneau.Aucun;
                _clientRemboursement = null;
                _montantRemboursement = 0;
                _referenceRemboursement = null;
                await ActualiserSession();
            }
        }
        finally
        {
            _remboursementEnCours = false;
        }
    }

    private static Article Article(ArticleVendable v) =>
        new(v.ArticleId, v.CodeArticle, v.Libelle, v.LibelleTraduit, v.UniteStock, v.PrecisionQuantite, true);

    public async ValueTask DisposeAsync()
    {
        _rechercheDifferee?.Cancel();
        await _arret.CancelAsync();
        _arret.Dispose();
        if (_raccourcis is not null)
        {
            try
            {
                await _raccourcis.InvokeVoidAsync("arreter");
                await _raccourcis.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
                // Page fermée : l'écouteur disparaît avec elle.
            }
        }

        _moi?.Dispose();
    }
