@page "/caisse"
@inject Api Api
@inject IJSRuntime Js
@inject CacheCaisse Cache
@inject StockageLocal Stockage
@inject CaisseHorsLigne HorsLigne
@inject EtatConnexion Connexion
@inject Session Session
@inject Boutique Boutique
@inject Confirmation Confirmation
@inject EtatMenu EtatMenu
@implements IAsyncDisposable

<PageTitle>@L["Caisse"] · GestionStock</PageTitle>

@if (!_charge)
{
    <Chargement />
}
else if (_session is null)
{
    <h1>@L["Caisse"]</h1>
    <Message Texte="@_erreur" />
    <Message Texte="@_succes" Erreur="false" />
    <form class="fiche etroite" @onsubmit="Ouvrir">
        <h2>@L["OuvrirSession"]</h2>
        <label class="champ">@L["Poste"]
            <select @bind="_poste">
                @foreach (var poste in _postes)
                {
                    <option value="@poste">@poste@(Occupation(poste) is not null ? $" — {L["Occupe"]}" : "")</option>
                }
            </select>
        </label>
        @if (Occupation(_poste) is { } occupation)
        {
            @* Poste bloqué par une session restée ouverte : qui la tient, depuis quand, et à qui s'adresser (décision 36). *@
            <div class="message avertissement" role="status">
                <Icone Nom="attention" />
                <span>@L["PosteOccupePar", occupation.NomCaissier ?? occupation.Caissier, Format.Date(occupation.OuvertureUtc)]</span>
            </div>
        }
        <label class="champ">@L["FondCaisse"]
            <input type="number" min="0" step="1" @bind="_fond" />
        </label>
        <div class="billets">
            @foreach (var billet in VenteEnCours.Billets)
            {
                <button type="button" @onclick="() => _fond += billet">+ @Format.Montant(billet)</button>
            }
            <button type="button" @onclick="() => _fond = 0">@L["Zero"]</button>
        </div>
        <div class="actions"><Bouton Type="submit" Variante="VarianteBouton.Principal" NomIcone="caisse" Occupe="_ouverture" Desactive="@(Occupation(_poste) is not null)">@L["OuvrirSession"]</Bouton></div>
    </form>
}
else if (_dernierTicket is not null)
{
    <h1>@(_dernierTicket.EstAvoir ? L["Avoir"] : L["Ticket"]) @_dernierTicket.Numero</h1>
    @if (_dernierTicket.Rendu > 0)
    {
        <div class="rendu-grand">@L["Rendu"] : @Format.Montant(_dernierTicket.Rendu)</div>
    }
    <RecuTicket Ticket="_dernierTicket">
        @* Le curseur arrive sur ce bouton : Entrée (ou F2) lance la vente suivante. *@
        <button id="nouvelle-vente" class="valider" @onclick="NouvelleVente">@L["NouvelleVente"] <kbd>F2</kbd></button>
    </RecuTicket>
}
else
{
    @* .vente : le cadre passe en « plein comptoir » (menu en tiroir) tant que la vente est affichée. *@
    <div class="vente">
        <header class="entete-caisse">
            <div class="titre-caisse">
                <button type="button" class="ouvrir-menu icone-seule" aria-controls="menu" aria-expanded="@(EtatMenu.Ouvert ? "true" : "false")"
                        aria-label="@L["Menu"]" title="@L["Menu"]" @onclick="EtatMenu.Basculer"><Icone Nom="menu" /></button>
                <h1>@L["Caisse"]</h1>
                <span class="badge-poste">@_session.NumeroCaisse</span>
                <span class="discret">@L["TotauxSession", _session.Totaux.NombreVentes, Format.Montant(_session.Totaux.Ventes)]</span>
            </div>
            <div class="actions">
                <a class="bouton" href="caisse/tickets">@L["TicketsDuJour"]</a>
                <Bouton OnClick="() => _panneau = Panneau.Remboursement">@L["RemboursementCredit"]</Bouton>
                <Bouton OnClick="() => _panneau = Panneau.Cloture">@L["Cloturer"]</Bouton>
            </div>
        </header>

        <Message Texte="@_erreur" />
        <Message Texte="@_succes" Erreur="false" />

        @if (_panneau == Panneau.Cloture)
        {
            <form class="fiche" @onsubmit="Cloturer">
                <h2>@L["Cloturer"]</h2>
                <p class="discret">@L["ClotureAide"]</p>
                <ComptageEspeces @bind-Total="_especesComptees" />
                <div class="actions">
                    <Bouton Type="submit" Variante="VarianteBouton.Principal" Occupe="_clotureEnCours">@L["CloturerAvec", Format.Montant(_especesComptees)]</Bouton>
                    <Bouton OnClick="() => _panneau = Panneau.Aucun">@L["Annuler"]</Bouton>
                </div>
            </form>
        }
        else if (_panneau == Panneau.Remboursement)
        {
            <form class="fiche" @onsubmit="Rembourser">
                <h2>@L["RemboursementCredit"]</h2>
                <ChoixClient @bind-Client="_clientRemboursement" />
                @if (_clientRemboursement is not null)
                {
                    <p>@L["SoldeDu"] : <strong>@Format.Montant(_clientRemboursement.SoldeDu)</strong></p>
                }
                <div class="grille">
                    <label class="champ">@L["Montant"] <input type="number" min="1" step="1" @bind="_montantRemboursement" required /></label>
                    <label class="champ">@L["Mode"]
                        <select @bind="_modeRemboursement">
                            <option value="@ModesPaiement.Especes">@L["Mode.Especes"]</option>
                            <option value="@ModesPaiement.MobileMoney">@L["Mode.MobileMoney"]</option>
                        </select>
                    </label>
                    @if (_modeRemboursement == ModesPaiement.MobileMoney)
                    {
                        <label class="champ">@L["Reference"] <input @bind="_referenceRemboursement" required /></label>
                    }
                </div>
                <div class="actions">
                    <Bouton Type="submit" Variante="VarianteBouton.Principal" Occupe="_remboursementEnCours" Desactive="@(_clientRemboursement is null)">@L["Encaisser"]</Bouton>
                    <Bouton OnClick="() => _panneau = Panneau.Aucun">@L["Annuler"]</Bouton>
                </div>
            </form>
        }

        <div class="caisse">
            <section class="saisie-vente">
                <div class="champ-scan">
                    <Icone Nom="codebarres" />
                    <input id="scan" type="search" placeholder="@L["ScanOuRecherche"]" aria-label="@L["ScanOuRecherche"]" @bind="_saisie" @bind:event="oninput" @bind:after="SurSaisie" @onkeydown="SurTouche" autocomplete="off" enterkeyhint="search" />
                    <kbd>F2</kbd>
                </div>

                @if (_resultats.Count > 0)
                {
                    <h2 class="titre-section">@L["Resultats"]</h2>
                    <div class="grille-articles">
                        @foreach (var vendable in _resultats)
                        {
                            <button type="button" class="tuile-article" @onclick="() => Ajouter(vendable)">
                                <strong>@Format.Libelle(Article(vendable))</strong>
                                <small>@Format.Unite(vendable.LibelleConditionnement) · @vendable.CodeArticle</small>
                            </button>
                        }
                    </div>
                }
                else if (_rapides.Count > 0)
                {
                    <h2 class="titre-section">@L["ArticlesRapides"]</h2>
                    <div class="grille-articles">
                        @foreach (var vendable in _rapides)
                        {
                            <button type="button" class="tuile-article" @onclick="() => Ajouter(vendable)">
                                <strong>@Format.Libelle(Article(vendable))</strong>
                                <small>@Format.Unite(vendable.LibelleConditionnement)@(PrixRapide(vendable))</small>
                            </button>
                        }
                    </div>
                }

                <div class="carte-panier">
                <div class="entete-panier"><h2>@L["Panier"]</h2><span>@L["NombreLignes", _vente.Lignes.Count]</span></div>
                <ul class="panier">
                    @foreach (var ligne in _vente.Lignes)
                    {
                        <li class="ligne-panier @(ligne == _ligneChoisie ? "choisie" : "")" @onclick="() => Choisir(ligne)">
                            <div class="designation">
                                <strong>@Format.Libelle(Article(ligne.Vendable))</strong>
                                <small>@Format.Unite(ligne.Vendable.LibelleConditionnement) · @Format.Montant(ligne.Prix)</small>
                            </div>
                            <div class="quantite" @onclick:stopPropagation="true">
                                <button type="button" title="@L["Moins"]" aria-label="@L["Moins"]" @onclick="() => PuisScanner(() => VenteEnCours.Decrementer(ligne))">−</button>
                                <input type="number" min="0" step="@VenteEnCours.PasSaisie(ligne.Vendable)" aria-label="@L["Quantite"]" @bind="ligne.Quantite" />
                                <button type="button" title="@L["Plus"]" aria-label="@L["Plus"]" @onclick="() => PuisScanner(() => VenteEnCours.Incrementer(ligne))">+</button>
                            </div>
                            <div class="montant">@Format.Montant(ligne.Montant)</div>
                            <div class="outils-ligne" @onclick:stopPropagation="true">
                                @if (_remiseOuverte == ligne || ligne.Remise > 0)
                                {
                                    <label class="remise">@L["Remise"] <input type="number" min="0" step="1" @bind="ligne.Remise" /></label>
                                }
                                else
                                {
                                    <button type="button" class="lien" @onclick="() => _remiseOuverte = ligne">@L["Remise"]</button>
                                }
                                <button type="button" class="retirer" title="@L["Retirer"]" aria-label="@L["Retirer"]" @onclick="() => PuisScanner(() => Retirer(ligne))"><Icone Nom="fermer" /></button>
                            </div>
                        </li>
                    }
                    @if (_vente.EstVide)
                    {
                        <li class="vide"><Icone Nom="caisse" />@L["PanierVide"]</li>
                    }
                </ul>
                </div>
            </section>

            <aside class="encaissement" id="encaissement">
                <div class="total-a-payer"><span>@L["TotalAPayer"]</span><strong class="total-grand" aria-live="polite">@Format.Montant(_vente.Total)</strong></div>

                <div class="champ-client"><span class="libelle-champ">@L["ClientCredit"]</span><ChoixClient @bind-Client="_client" Libelle="@L["ClientCredit"]" Aide="@L["NomOuTelephone"]" /></div>

                <span class="libelle-champ">@L["Paiements"]</span>
                <div class="modes">
                    @foreach (var mode in ModesPaiement.Tous)
                    {
                        <button type="button" class="@(_vente.Paiements.Any(p => p.Mode == mode) ? "choisi" : "")" @onclick="() => _vente.AjouterPaiement(mode)"
                                disabled="@(_vente.EstVide || (mode == ModesPaiement.Credit && _client is null))">@L[$"Mode.{mode}"]</button>
                    }
                </div>

                <span class="libelle-champ">@L["EspecesRecues"]</span>
                <div class="billets">
                    @foreach (var billet in VenteEnCours.Billets)
                    {
                        <button type="button" disabled="@_vente.EstVide" @onclick="() => PuisScanner(() => _vente.AjouterEspeces(billet))">@Format.Montant(billet)</button>
                    }
                    <button type="button" class="valider" disabled="@_vente.EstVide" @onclick="() => PuisScanner(_vente.CompteJuste)">@L["CompteJuste"] <kbd>F4</kbd></button>
                </div>

                @foreach (var paiement in _vente.Paiements)
                {
                    <div class="paiement">
                        <span>@L[$"Mode.{paiement.Mode}"]</span>
                        <input type="number" min="0" step="1" aria-label="@L[$"Mode.{paiement.Mode}"]" @bind="paiement.Montant" />
                        <button type="button" class="bouton-discret icone-seule" title="@L["Retirer"]" aria-label="@L["Retirer"]" @onclick="() => _vente.RetirerPaiement(paiement)"><Icone Nom="fermer" /></button>
                        @if (paiement.Mode is ModesPaiement.MobileMoney or ModesPaiement.Carte)
                        {
                            <input class="reference" placeholder="@L["Reference"]" aria-label="@L["Reference"]" @bind="paiement.Reference" />
                        }
                    </div>
                }
                <div class="ligne-recu @(_vente.Reste < 0 ? "a-rendre" : "")" aria-live="polite">
                    <span>@(_vente.Reste >= 0 ? L["ResteAPayer"] : L["Rendu"])</span><strong>@Format.Montant(Math.Abs(_vente.Reste))</strong>
                </div>

                @if (_paveVisible)
                {
                    <div class="cibles-pave">
                        <button type="button" class="@(_cible == CiblePave.Quantite ? "choisi" : "")" disabled="@(_ligneChoisie is null)" @onclick="() => _cible = CiblePave.Quantite">@L["Quantite"]</button>
                        <button type="button" class="@(_cible == CiblePave.Especes ? "choisi" : "")" @onclick="() => _cible = CiblePave.Especes">@L["Mode.Especes"]</button>
                    </div>
                    <PaveNumerique Titre="@TitrePave" Decimal="@PaveDecimal" Valide="AppliquerPave" />
                }
                <button type="button" class="lien" aria-expanded="@(_paveVisible ? "true" : "false")" @onclick="() => _paveVisible = !_paveVisible">@L["PaveNumerique"]</button>

                @if (_validationNecessaire || _vente.Lignes.Any(l => l.Remise > 0))
                {
                    <div class="validation">
                        <strong>@L["ValidationResponsable"]</strong>
                        <input placeholder="@L["Matricule"]" aria-label="@L["Matricule"]" @bind="_validationIdentifiant" autocomplete="off" />
                        <ChampMotDePasse @bind-Valeur="_validationMotDePasse" Placeholder="@L["MotDePasse"]" Autocomplete="off" />
                    </div>
                }

                <button class="principal encaisser" disabled="@(!PeutEncaisser)" @onclick="Encaisser">@L["Encaisser"] <kbd>F8</kbd></button>
                <button type="button" class="bouton-discret annuler-vente" disabled="@_vente.EstVide" @onclick="AnnulerVente">@L["AnnulerVente"]</button>
            </aside>
        </div>

        @* Tablette et téléphone : total et reste toujours visibles en bas de l'écran pendant le scan. *@
        <div class="barre-total" aria-hidden="@(_vente.EstVide ? "true" : "false")">
            <div class="montants">
                <strong>@Format.Montant(_vente.Total)</strong>
                <small>@(_vente.Reste >= 0 ? L["ResteAPayer"] : L["Rendu"]) : @Format.Montant(Math.Abs(_vente.Reste))</small>
            </div>
            @if (PeutEncaisser)
            {
                <button class="principal" @onclick="Encaisser">@L["Encaisser"]</button>
            }
            else
            {
                <button type="button" class="valider" disabled="@_vente.EstVide" @onclick="AllerAuPaiement">@L["Payer"] <Icone Nom="aller" /></button>
            }
        </div>
    </div>
}

@code {
    private enum Panneau { Aucun, Cloture, Remboursement }

    private enum CiblePave { Quantite, Especes }

    private bool _charge;
    private SessionCaisse? _session;
    private List<string> _postes = [];
    private string _poste = "";
    private decimal _fond;
    private string? _erreur;
    private string? _succes;
    private Panneau _panneau;

    private VenteEnCours _vente = new();
    private string _saisie = "";
    private List<ArticleVendable> _resultats = [];
    private List<ArticleVendable> _rapides = [];
    private Dictionary<Guid, decimal> _prixRapides = [];
    private ClientCredit? _client;
    private Guid _idIdempotence = Guid.NewGuid();
    private bool _validationNecessaire;
    private string _validationIdentifiant = "";
    private string _validationMotDePasse = "";
    private bool _enCours;
    private TicketCaisse? _dernierTicket;
    private LignePanier? _ligneChoisie;
    private LignePanier? _remiseOuverte;
    private bool _paveVisible;
    private CiblePave _cible = CiblePave.Especes;
    private CancellationTokenSource? _rechercheDifferee;
    private DotNetObjectReference<Caisse>? _moi;
    private IJSObjectReference? _raccourcis;

    private decimal _especesComptees;
    private ClientCredit? _clientRemboursement;
    private decimal _montantRemboursement;
    private bool _remboursementEnCours;
    private bool _ouverture;
    private bool _clotureEnCours;

    // Clé du remboursement en cours de saisie : gardée jusqu'à son enregistrement, un nouvel envoi (double clic,
    // réponse perdue) est reconnu par le serveur au lieu d'être compté deux fois.
    private Guid _idRemboursement = Guid.NewGuid();
    private string _modeRemboursement = ModesPaiement.Especes;
    private string? _referenceRemboursement;

    private List<OccupationPoste> _occupations = [];
    private bool _focaliserNouvelleVente;
    private readonly CancellationTokenSource _arret = new();

    private bool PeutEncaisser => !_enCours && !_vente.EstVide && _vente.Reste <= 0;

    private OccupationPoste? Occupation(string poste) => _occupations.FirstOrDefault(o => o.NumeroCaisse == poste);

    private string TitrePave => _cible == CiblePave.Quantite && _ligneChoisie is { } ligne
        ? L["PaveQuantite", Format.Libelle(Article(ligne.Vendable))]
        : L["EspecesRecues"];

    /// <summary>Virgule au pavé : seulement pour la quantité d'un article vendu au poids.</summary>
    private bool PaveDecimal => _cible == CiblePave.Quantite && _ligneChoisie is { } ligne && VenteEnCours.Pas(ligne.Vendable) < 1m;

    private string PrixRapide(ArticleVendable vendable) =>
        _prixRapides.TryGetValue(vendable.ConditionnementId, out var prix) ? $" · {Format.Montant(prix)}" : "";

    protected override async Task OnInitializedAsync()
    {
        // Ouverture rapide sur une connexion lente (ENF10) : ce que le poste garde est relu d'abord, puis les demandes
        // au serveur partent ensemble au lieu de l'une après l'autre.
        await Cache.ChargerAsync();
        var postes = Api.GetAsync<List<string>>("api/caisse/postes");
        await Task.WhenAll(postes, ChargerSessionEtOccupations(), ChargerRapides());
        _postes = postes.Result.Valeur ?? [];
        _poste = _postes.FirstOrDefault() ?? "";
        _charge = true;

        // Données gardées sur le poste pour vendre hors ligne (7.8) : rafraîchies en arrière-plan à l'ouverture puis
        // toutes les 5 minutes tant que le serveur répond (seul ce qui a changé est téléchargé). Le navigateur est prié
        // de ne jamais vider ce stockage.
        _ = RafraichirCacheEnBoucleAsync();
    }

    private async Task ChargerSessionEtOccupations()
    {
        await ChargerSession();
        await ChargerOccupations();
    }

    private async Task RafraichirCacheEnBoucleAsync()
    {
        try
        {
            await Cache.RafraichirAsync();
            await Stockage.PersisterAsync();
            using var minuterie = new PeriodicTimer(TimeSpan.FromMinutes(5));
            while (await minuterie.WaitForNextTickAsync(_arret.Token))
            {
                if (Connexion.EnLigne)
                {
                    await Cache.RafraichirAsync();
                }
            }
        }
        catch (OperationCanceledException)
        {
            // Page quittée.
        }
    }

    /// <summary>Totaux de la session après une vente ou un remboursement : la session seule, pas tous ses tickets.</summary>
    private async Task ActualiserSession()
    {
        if ((await Api.GetAsync<SessionCaisse>("api/caisse/sessions/courante")).Valeur is { } session)
        {
            _session = session;
            await HorsLigne.GarderSessionAsync(session);
        }
    }

    /// <summary>Postes tenus par une session ouverte : le poste proposé d'abord est un poste libre.</summary>
    private async Task ChargerOccupations()
    {
        if (_session is not null)
        {
            return;
        }

        _occupations = (await Api.GetAsync<List<OccupationPoste>>("api/caisse/postes/occupation")).Valeur ?? [];
        if (Occupation(_poste) is not null && _postes.FirstOrDefault(p => Occupation(p) is null) is { } libre)
        {
            _poste = libre;
        }
    }

    /// <summary>
    /// Le curseur revient dans le champ de scan (douchette) à l'ouverture, après un ajout d'article et pour une
    /// nouvelle vente, mais jamais pendant une saisie dans un autre champ.
    /// </summary>
    private bool _focaliserScan = true;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // Écran tactile : pavé numérique affiché d'office. Raccourcis clavier F2, F4, F8 et Échap.
            _paveVisible = await Js.InvokeAsync<bool>("gestionStock.tactile");
            _moi = DotNetObjectReference.Create(this);
            _raccourcis = await Js.InvokeAsync<IJSObjectReference>("gestionStock.raccourcis", _moi, new[] { "F2", "F4", "F8", "Escape" });
            StateHasChanged();
        }

        if (_focaliserScan && _session is not null && _dernierTicket is null && _panneau == Panneau.Aucun)
        {
            _focaliserScan = false;
            await Js.InvokeVoidAsync("gestionStock.focaliser", "scan");
        }

        if (_focaliserNouvelleVente && _dernierTicket is not null)
        {
            _focaliserNouvelleVente = false;
            await Js.InvokeVoidAsync("gestionStock.focaliser", "nouvelle-vente");
        }
    }

    /// <summary>Raccourcis clavier du comptoir, relayés par l'écouteur de <c>outils.js</c>.</summary>
    [JSInvokable]
    public async Task Raccourci(string touche)
    {
        if (_session is null)
        {
            return;
        }

        if (_dernierTicket is not null)
        {
            // Écran du reçu : F2 lance la vente suivante (comme Entrée sur le bouton, qui a le curseur).
            if (touche == "F2")
            {
                NouvelleVente();
                StateHasChanged();
            }

            return;
        }

        switch (touche)
        {
            case "F2":
                _focaliserScan = true;
                break;
            case "F4" when !_vente.EstVide:
                _vente.CompteJuste();
                break;
            case "F8" when PeutEncaisser:
                await Encaisser();
                break;
            case "Escape":
                _resultats = [];
                _saisie = "";
                _remiseOuverte = null;
                _panneau = Panneau.Aucun;
                _focaliserScan = true;
                break;
        }

        StateHasChanged();
    }

    /// <summary>
    /// Session ouverte du caissier. En ligne, elle est gardée sur le poste avec le dernier numéro de son poste et ses
    /// tickets ; serveur injoignable, la caisse reprend celle du poste (7.8). L'ouverture, elle, exige le serveur
    /// (décision 40).
    /// </summary>
    private async Task ChargerSession()
    {
        var resultat = await Api.GetAsync<SessionCaisse>("api/caisse/sessions/courante");
        if (resultat.Code == Api.CodeHorsLigne)
        {
            _session = await HorsLigne.SessionGardeeAsync();
            _erreur = _session is null ? L["OuvertureHorsLigne"].Value : null;
            return;
        }

        _session = resultat.Valeur;
        _erreur = resultat.Erreur;
        if (_session is { } session)
        {
            await HorsLigne.GarderSessionAsync(session);
            if ((await Api.GetAsync<List<TicketCaisse>>($"api/caisse/sessions/{session.Id}/tickets")).Valeur is { } tickets)
            {
                await HorsLigne.GarderTicketsAsync(session.Id, tickets);
            }
        }
    }

    /// <summary>Articles rapides choisis par le Gérant, avec leur prix lu une fois à l'ouverture de l'écran.</summary>
    private async Task ChargerRapides()
    {
        var rapides = await Api.GetAsync<List<ArticleVendable>>("api/referentiel/vendables/rapides");
        if (rapides.Code == Api.CodeHorsLigne)
        {
            await Cache.ChargerAsync();
            _rapides = Cache.Catalogue?.Rapides.ToList() ?? [];
            _prixRapides = _rapides
                .Select(v => (v.ConditionnementId, Prix: Cache.Catalogue!.Prix(v.ConditionnementId, Format.JourDouala(DateTime.UtcNow))))
                .Where(p => p.Prix is not null).ToDictionary(p => p.ConditionnementId, p => p.Prix!.Value);
            return;
        }

        _rapides = rapides.Valeur ?? [];
        if (Cache.EstFrais)
        {
            _prixRapides = _rapides
                .Select(v => (v.ConditionnementId, Prix: Cache.Catalogue!.Prix(v.ConditionnementId, Format.JourDouala(DateTime.UtcNow))))
                .Where(p => p.Prix is not null).ToDictionary(p => p.ConditionnementId, p => p.Prix!.Value);
            return;
        }

        var prix = await Task.WhenAll(_rapides.Select(async v =>
            (v.ConditionnementId, Prix: (await Api.GetAsync<PrixApplicable>($"api/prix/conditionnements/{v.ConditionnementId}")).Valeur)));
        _prixRapides = prix.Where(p => p.Prix is not null).ToDictionary(p => p.ConditionnementId, p => p.Prix!.PrixTtc);
    }

    /// <summary>Un seul envoi à la fois : un double appui n'ouvre pas deux fois (bouton occupé pendant l'appel).</summary>
    private Task Ouvrir() => UneFois(() => _ouverture, v => _ouverture = v, OuvrirAsync);

    private Task Cloturer() => UneFois(() => _clotureEnCours, v => _clotureEnCours = v, CloturerAsync);

    private static async Task UneFois(Func<bool> enCours, Action<bool> marquer, Func<Task> action)
    {
        if (enCours())
        {
            return;
        }

        marquer(true);
        try
        {
            await action();
        }
        finally
        {
            marquer(false);
        }
    }

    private async Task OuvrirAsync()
    {
        var resultat = await Api.PostAsync<SessionCaisse>("api/caisse/sessions", new { NumeroCaisse = _poste, FondCaisse = _fond });
        _erreur = resultat.Erreur;
        _session = resultat.Valeur ?? _session;
        _focaliserScan = true;
        if (resultat.Valeur is { } ouverte)
        {
            // Gardée aussitôt sur le poste : une coupure juste après l'ouverture n'empêche pas de vendre (7.8).
            await HorsLigne.GarderSessionAsync(ouverte);
        }

        if (resultat.Code == "Caisse.PosteOccupe")
        {
            // Poste pris entre-temps : on montre qui l'occupe.
            _erreur = null;
            await ChargerOccupations();
        }
    }

    /// <summary>
    /// Un texte avec des lettres lance la recherche après une courte pause de frappe ; des chiffres seuls sont un
    /// code-barres en cours de saisie par la douchette, traité à la touche Entrée.
    /// </summary>
    private async Task SurSaisie()
    {
        _rechercheDifferee?.Cancel();
        var texte = _saisie.Trim();
        if (texte.Length < 2 || !texte.Any(char.IsLetter))
        {
            _resultats = [];
            return;
        }

        var annulation = new CancellationTokenSource();
        _rechercheDifferee = annulation;
        try
        {
            await Task.Delay(250, annulation.Token);
        }
        catch (TaskCanceledException)
        {
            return;
        }

        _resultats = await Rechercher(texte);
    }

    /// <summary>Entrée : code-barres ou code article d'abord ; sinon recherche, et un résultat unique est ajouté.</summary>
    private async Task SurTouche(KeyboardEventArgs e)
    {
        if (e.Key != "Enter" || string.IsNullOrWhiteSpace(_saisie))
        {
            return;
        }

        _rechercheDifferee?.Cancel();
        var texte = _saisie.Trim();
        // Catalogue du poste vérifié depuis peu : le code est reconnu sans aller-retour au serveur.
        if (Cache.EstFrais && Cache.Catalogue!.Resoudre(texte) is { } connu)
        {
            await Ajouter(connu);
            return;
        }

        var scan = Connexion.EnLigne
            ? await Api.GetAsync<ArticleVendable>($"api/referentiel/scan/{Uri.EscapeDataString(texte)}")
            : new Resultat<ArticleVendable>(default, null, Api.CodeHorsLigne);
        if (scan.Code == Api.CodeHorsLigne)
        {
            await Cache.ChargerAsync();
            scan = Cache.Catalogue?.Resoudre(texte) is { } local
                ? new Resultat<ArticleVendable>(local, null)
                : new Resultat<ArticleVendable>(default, L["CodeInconnuHorsLigne", texte]);
        }

        if (scan.Valeur is { } vendable)
        {
            await Ajouter(vendable);
            return;
        }

        var trouves = await Rechercher(texte);
        if (trouves.Count == 1)
        {
            await Ajouter(trouves[0]);
            return;
        }

        _resultats = trouves;
        _erreur = trouves.Count == 0 ? scan.Erreur : null;
    }

    private async Task<List<ArticleVendable>> Rechercher(string texte)
    {
        var trouves = Connexion.EnLigne
            ? await Api.GetAsync<List<ArticleVendable>>($"api/referentiel/vendables?recherche={Uri.EscapeDataString(texte)}")
            : new Resultat<List<ArticleVendable>>(default, null, Api.CodeHorsLigne);
        if (trouves.Code != Api.CodeHorsLigne)
        {
            return trouves.Valeur ?? [];
        }

        await Cache.ChargerAsync();
        return Cache.Catalogue?.Rechercher(texte).ToList() ?? [];
    }

    private async Task Ajouter(ArticleVendable vendable)
    {
        _succes = null;
        _resultats = [];
        _saisie = "";
        _focaliserScan = true;
        if (_vente.Ligne(vendable.ConditionnementId) is { } existante)
        {
            VenteEnCours.Incrementer(existante);
            _ligneChoisie = existante;
            _erreur = null;
            return;
        }

        // Le prix affiché vient de la grille du poste si elle a été vérifiée depuis peu, sinon du serveur ; le serveur le
        // relit de toute façon à l'encaissement (RG37).
        if (Cache.EstFrais && Cache.Catalogue!.Prix(vendable.ConditionnementId, Format.JourDouala(DateTime.UtcNow)) is { } prixLocal)
        {
            _erreur = null;
            _ligneChoisie = _vente.Ajouter(vendable, prixLocal);
            return;
        }

        var prix = Connexion.EnLigne
            ? await Api.GetAsync<PrixApplicable>($"api/prix/conditionnements/{vendable.ConditionnementId}")
            : new Resultat<PrixApplicable>(default, null, Api.CodeHorsLigne);
        decimal? prixTtc = prix.Valeur?.PrixTtc;
        if (prix.Code == Api.CodeHorsLigne)
        {
            await Cache.ChargerAsync();
            prixTtc = Cache.Catalogue?.Prix(vendable.ConditionnementId, Format.JourDouala(DateTime.UtcNow));
        }

        if (prixTtc is not { } prixDuJour)
        {
            _erreur = prix.Code == Api.CodeHorsLigne || prix.Erreur is null ? L["PrixAbsentArticle", vendable.CodeArticle] : prix.Erreur;
            return;
        }

        _erreur = null;
        _ligneChoisie = _vente.Ajouter(vendable, prixDuJour);
    }

    private void Choisir(LignePanier ligne)
    {
        _ligneChoisie = ligne;
        _cible = CiblePave.Quantite;
    }

    private void Retirer(LignePanier ligne)
    {
        _vente.Retirer(ligne);
        if (_ligneChoisie == ligne)
        {
            _ligneChoisie = null;
            _cible = CiblePave.Especes;
        }
    }

    /// <summary>
    /// Action d'un bouton du comptoir, puis retour du curseur dans le champ de scan : sans cela, le code lu ensuite
    /// par la douchette partirait vers le bouton cliqué et serait perdu.
    /// </summary>
    private void PuisScanner(Action action)
    {
        action();
        _focaliserScan = true;
    }

    /// <summary>Pavé numérique : quantité de la ligne choisie, ou espèces reçues du client.</summary>
    private void AppliquerPave(decimal valeur)
    {
        _focaliserScan = true;
        if (_cible == CiblePave.Quantite && _ligneChoisie is { } ligne)
        {
            if (valeur >= VenteEnCours.Pas(ligne.Vendable))
            {
                ligne.Quantite = valeur;
            }

            return;
        }

        if (_vente.Paiements.FirstOrDefault(p => p.Mode == ModesPaiement.Especes) is { } especes)
        {
            especes.Montant = valeur;
        }
        else
        {
            _vente.AjouterEspeces(valeur);
        }
    }

    private async Task AllerAuPaiement() => await Js.InvokeVoidAsync("gestionStock.defiler", "encaissement");

    private async Task AnnulerVente()
    {
        if (await Confirmation.DemanderAsync(L["ConfirmerAnnulationVente"].Value, L["AnnulerVente"].Value, danger: true))
        {
