@page "/"
@inject Session Session

<PageTitle>@L["Accueil"] · GestionStock</PageTitle>

@if (Session.Profil is { } profil)
{
    <h1>@L["Bonjour", profil.Identifiant]</h1>
    <p class="discret">@L["AccueilIntro"]</p>

    <div class="tuiles">
        @if (Session.A(Permissions.CaisseVendre))
        {
            <a class="tuile" href="caisse"><strong>@L["Caisse"]</strong><span>@L["CaisseAide"]</span></a>
        }
        @if (Session.A(Permissions.SessionsConsulter))
        {
            <a class="tuile" href="sessions"><strong>@L["SessionsCaisse"]</strong><span>@L["SessionsAide"]</span></a>
        }
        @if (Session.A(Permissions.CreditConsulter))
        {
            <a class="tuile" href="clients"><strong>@L["Clients"]</strong><span>@L["ClientsAide"]</span></a>
        }
        @if (Session.A(Permissions.ReceptionsSaisir))
        {
            <a class="tuile" href="receptions/nouvelle"><strong>@L["NouvelleReception"]</strong><span>@L["NouvelleReceptionAide"]</span></a>
        }
        @if (Session.A(Permissions.StockConsulter))
        {
            <a class="tuile" href="stock"><strong>@L["Stock"]</strong><span>@L["StockAide"]</span></a>
        }
        @if (Session.A(Permissions.ArticlesGerer))
        {
            <a class="tuile" href="articles"><strong>@L["Articles"]</strong><span>@L["ArticlesAide"]</span></a>
        }
        @if (Session.A(Permissions.InventaireConsulter))
        {
            <a class="tuile" href="inventaires"><strong>@L["Inventaires"]</strong><span>@L["InventairesAide"]</span></a>
            <a class="tuile" href="demarques"><strong>@L["Demarque"]</strong><span>@L["DemarqueAide"]</span></a>
        }
        @if (Session.A(Permissions.RapportsConsulter))
        {
            <a class="tuile" href="rapports"><strong>@L["Rapports"]</strong><span>@L["RapportsAide"]</span></a>
        }
        @if (Session.A(Permissions.ExportsProduire))
        {
            <a class="tuile" href="exports"><strong>@L["Exports"]</strong><span>@L["ExportsAide"]</span></a>
        }
        @if (Session.A(Permissions.PaiementsFournisseursSaisir))
        {
            <a class="tuile" href="dettes"><strong>@L["DettesFournisseurs"]</strong><span>@L["DettesAide"]</span></a>
        }
        @if (Session.A(Permissions.RepriseImporter))
        {
            <a class="tuile" href="reprise"><strong>@L["Reprise"]</strong><span>@L["RepriseAide"]</span></a>
        }
        @if (Session.A(Permissions.UtilisateursGerer))
        {
            <a class="tuile" href="utilisateurs"><strong>@L["Utilisateurs"]</strong><span>@L["UtilisateursAide"]</span></a>
        }
    </div>
}
