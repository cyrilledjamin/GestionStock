@page "/"
@using System.Globalization
@inject Session Session
@inject Api Api

<PageTitle>@L["Accueil"] · GestionStock</PageTitle>

@if (Session.Profil is { } profil)
{
    <h1>@L["Bonjour", string.IsNullOrWhiteSpace(profil.Prenom) ? profil.Identifiant : profil.Prenom]</h1>
    <p class="discret">@L["AccueilIntro"]</p>

    @if (!_charge)
    {
        <Chargement />
    }
    else
    {
        @if (Session.A(Permissions.CaisseVendre))
        {
            @* Caissier : sa caisse d'abord, avec le chemin pour y aller. *@
            <section class="bloc-accueil">
                <h2>@L["MaCaisse"]</h2>
                <div class="indicateurs">
                    @if (_maSession is { } session)
                    {
                        <Indicateur Libelle="@L["SessionOuverteSur", session.NumeroCaisse, Format.Date(session.OuvertureUtc)]"
                                    Valeur="@Format.Montant(session.Totaux.Ventes - session.Totaux.Avoirs)"
                                    Detail="@L["NombreVentes", session.Totaux.NombreVentes]" Lien="caisse">
                            <em class="aller">@L["ReprendreLaVente"] <Icone Nom="aller" /></em>
                        </Indicateur>
                    }
                    else
                    {
                        <Indicateur Libelle="@L["AucuneSessionOuverte"]" Valeur="—" Lien="caisse">
                            <em class="aller">@L["OuvrirLaCaisse"] <Icone Nom="aller" /></em>
                        </Indicateur>
                    }
                </div>
            </section>
        }

        @if (_tableau is { } t)
        {
            <section class="bloc-accueil">
                <h2>@L["Aujourdhui"] <small class="discret">@t.Jour.ToString("D", CultureInfo.CurrentCulture)</small></h2>
                <div class="indicateurs">
                    <Indicateur Libelle="@L["VentesDuJour"]" Valeur="@Format.Montant(t.VentesDuJour.ChiffreAffairesTtc)"
                                Detail="@L["NombreTickets", t.VentesDuJour.NombreVentes, t.VentesDuJour.NombreAvoirs]" Lien="rapports" />
                    <Indicateur Libelle="@L["Marge"]" Valeur="@Format.Montant(t.VentesDuJour.Marge)" Lien="rapports"
                                Detail="@TauxMarge(t.VentesDuJour.TauxMarge)" Ton="@(t.VentesDuJour.Marge < 0 ? Ton.Danger : Ton.Neutre)" />
                    <Indicateur Libelle="@L["CaissesOuvertes"]" Valeur="@Nombre(t.SessionsOuvertes)" Lien="sessions" />
                </div>

                @* Tendance : chargée après les chiffres du jour, qui ne l'attendent pas. *@
                @if (_tendance is { Count: > 0 } tendance)
                {
                    <Graphique Titre="@L["Tendance30Jours"]" Points="tendance" LibelleSerie="@L["VentesTtc"]" LibelleSecondaire="@L["Marge"]"
                               LibelleAbscisse="@L["Jour"]" />
                    <p class="discret resume-graphique">@L["TendanceResume", Format.Montant(_tendanceVentes), Format.Montant(_tendanceMarge)]</p>
                }
                else if (_tendanceEnCours)
                {
                    <Chargement />
                }
            </section>

            <section class="bloc-accueil">
                <h2>@L["ASurveiller"]</h2>
                <div class="indicateurs">
                    <Indicateur Libelle="@L["SessionsAValider"]" Valeur="@Nombre(t.SessionsAValider)" Lien="sessions"
                                Detail="@(t.SessionsAValider > 0 ? L["EcartsCumules", Format.Montant(t.EcartsAValider)].Value : null)"
                                Ton="@(t.SessionsAValider > 0 ? Ton.Attention : Ton.Neutre)" />
                    <Indicateur Libelle="@L["AnomaliesATraiter"]" Valeur="@Nombre(t.AnomaliesATraiter)" Lien="anomalies"
                                Detail="@L["AnomaliesHorsLigne"]" Ton="@(t.AnomaliesATraiter > 0 ? Ton.Attention : Ton.Neutre)" />
                    <Indicateur Libelle="@L["StocksNegatifs"]" Valeur="@Nombre(t.StocksNegatifs)" Lien="stock"
                                Detail="@L["ValeurDuStock", Format.Montant(t.ValeurStock)]" Ton="@(t.StocksNegatifs > 0 ? Ton.Danger : Ton.Neutre)" />
                    <Indicateur Libelle="@L["CreancesClients"]" Valeur="@Format.Montant(t.TotalCreances)" Lien="clients"
                                Detail="@(t.TotalEnRetard > 0 ? L["DontEnRetard", Format.Montant(t.TotalEnRetard)].Value : null)"
                                Ton="@(t.TotalEnRetard > 0 ? Ton.Attention : Ton.Neutre)" />
                    <Indicateur Libelle="@L["DettesFournisseurs"]" Valeur="@Format.Montant(t.TotalDettes)" Lien="dettes" />
                </div>
            </section>
        }

        @if (_exploitation is { } e)
        {
            @* Administrateur, Gérant, Comptable : cohérence des soldes (ENF04) et sauvegardes (décision 32). *@
            var sauvegardesEnRetard = e.SauvegardeLocaleEnRetard || e.SauvegardeHorsSiteEnRetard;
            <section class="bloc-accueil">
                <h2>@L["Exploitation"]</h2>
                <div class="indicateurs">
                    <Indicateur Libelle="@L["ControleDesSoldes"]" Valeur="@L["NombreEcarts", e.EcartsOuverts]" Lien="controles"
                                Detail="@(e.DernierControle is { } c ? L["DernierControleLe", Format.Date(c.DebutUtc)].Value : L["AucunControle"].Value)"
                                Ton="@(e.EcartsOuverts > 0 ? Ton.Danger : e.ControleEnRetard ? Ton.Attention : Ton.Neutre)" />
                    <Indicateur Libelle="@L["Sauvegardes"]" Lien="sauvegardes"
                                Valeur="@(e.DerniereSauvegardeLocale is { } s ? Format.Date(s.FinUtc) : L["Jamais"].Value)"
                                Detail="@(sauvegardesEnRetard ? L["SauvegardesEnRetard"].Value : L["SauvegardesAJour"].Value)"
                                Ton="@(sauvegardesEnRetard ? Ton.Danger : Ton.Neutre)" />
                </div>
            </section>
        }

        @if (_receptionsBrouillon is not null || _inventairesEnCours is not null || _demarquesDeclarees is not null)
        {
            <section class="bloc-accueil">
                <h2>@L["AFaire"]</h2>
                <div class="indicateurs">
                    @if (_receptionsBrouillon is { } receptions)
                    {
                        <Indicateur Libelle="@L["ReceptionsEnBrouillon"]" Valeur="@Nombre(receptions)" Lien="receptions"
                                    Ton="@(receptions > 0 ? Ton.Attention : Ton.Neutre)" />
                    }
                    @if (_inventairesEnCours is { } inventaires)
                    {
                        <Indicateur Libelle="@L["InventairesEnCours"]" Valeur="@Nombre(inventaires)" Lien="inventaires"
                                    Ton="@(inventaires > 0 ? Ton.Attention : Ton.Neutre)" />
                    }
                    @if (_demarquesDeclarees is { } demarques)
                    {
                        <Indicateur Libelle="@(Session.A(Permissions.DemarqueValider) ? L["DemarquesAValider"] : L["DemarquesEnAttente"])"
                                    Valeur="@Nombre(demarques)" Lien="demarques" Ton="@(demarques > 0 ? Ton.Attention : Ton.Neutre)" />
                    }
                </div>
            </section>
        }
    }

    <h2>@L["Raccourcis"]</h2>
    <div class="tuiles">
        @if (Session.A(Permissions.CaisseVendre))
        {
            <a class="tuile" href="caisse"><Icone Nom="caisse" /><strong>@L["Caisse"]</strong><span>@L["CaisseAide"]</span></a>
        }
        @if (Session.A(Permissions.SessionsConsulter))
        {
            <a class="tuile" href="sessions"><Icone Nom="sessions" /><strong>@L["SessionsCaisse"]</strong><span>@L["SessionsAide"]</span></a>
        }
        @if (Session.A(Permissions.CreditConsulter))
        {
            <a class="tuile" href="clients"><Icone Nom="clients" /><strong>@L["Clients"]</strong><span>@L["ClientsAide"]</span></a>
        }
        @if (Session.A(Permissions.ReceptionsSaisir))
        {
            <a class="tuile" href="receptions/nouvelle"><Icone Nom="receptions" /><strong>@L["NouvelleReception"]</strong><span>@L["NouvelleReceptionAide"]</span></a>
        }
        @if (Session.A(Permissions.StockConsulter))
        {
            <a class="tuile" href="stock"><Icone Nom="stock" /><strong>@L["Stock"]</strong><span>@L["StockAide"]</span></a>
        }
        @if (Session.A(Permissions.ArticlesGerer))
        {
            <a class="tuile" href="articles"><Icone Nom="articles" /><strong>@L["Articles"]</strong><span>@L["ArticlesAide"]</span></a>
        }
        @if (Session.A(Permissions.InventaireConsulter))
        {
            <a class="tuile" href="inventaires"><Icone Nom="inventaires" /><strong>@L["Inventaires"]</strong><span>@L["InventairesAide"]</span></a>
            <a class="tuile" href="demarques"><Icone Nom="demarque" /><strong>@L["Demarque"]</strong><span>@L["DemarqueAide"]</span></a>
        }
        @if (Session.A(Permissions.RapportsConsulter))
        {
            <a class="tuile" href="rapports"><Icone Nom="rapports" /><strong>@L["Rapports"]</strong><span>@L["RapportsAide"]</span></a>
        }
        @if (Session.A(Permissions.ExportsProduire))
        {
            <a class="tuile" href="exports"><Icone Nom="exports" /><strong>@L["Exports"]</strong><span>@L["ExportsAide"]</span></a>
        }
        @if (Session.A(Permissions.PaiementsFournisseursSaisir))
        {
            <a class="tuile" href="dettes"><Icone Nom="dettes" /><strong>@L["DettesFournisseurs"]</strong><span>@L["DettesAide"]</span></a>
        }
        @if (Session.A(Permissions.RepriseImporter))
        {
            <a class="tuile" href="reprise"><Icone Nom="reprise" /><strong>@L["Reprise"]</strong><span>@L["RepriseAide"]</span></a>
        }
        @if (Session.A(Permissions.ExploitationConsulter))
        {
            <a class="tuile" href="sauvegardes"><Icone Nom="sauvegardes" /><strong>@L["Sauvegardes"]</strong><span>@L["SauvegardesTuile"]</span></a>
        }
        @if (Session.A(Permissions.UtilisateursGerer))
        {
            <a class="tuile" href="utilisateurs"><Icone Nom="utilisateurs" /><strong>@L["Utilisateurs"]</strong><span>@L["UtilisateursAide"]</span></a>
        }
    </div>
}

@code {
    private bool _charge;
    private TableauDeBord? _tableau;
    private List<PointGraphique>? _tendance;
    private bool _tendanceEnCours;
    private decimal _tendanceVentes;
    private decimal _tendanceMarge;
    private SessionCaisse? _maSession;
    private int? _receptionsBrouillon;
    private int? _inventairesEnCours;
    private int? _demarquesDeclarees;
    private EtatExploitation? _exploitation;

    /// <summary>
    /// Chaque bloc ne se charge qu'avec la permission correspondante, en parallèle ; un bloc dont la lecture échoue
    /// est simplement omis (l'accueil reste utilisable, ses raccourcis aussi). La tendance des 30 jours, plus longue
    /// à calculer, s'affiche ensuite : les chiffres du jour ne l'attendent pas.
    /// </summary>
    protected override async Task OnInitializedAsync()
    {
        var lectures = new List<Task>();
        Task? tendance = null;
        if (Session.A(Permissions.RapportsConsulter))
        {
            lectures.Add(Lire(async () => _tableau = (await Api.GetAsync<TableauDeBord>("api/rapports/tableau-de-bord")).Valeur));
            _tendanceEnCours = true;
            tendance = Lire(LireTendanceAsync);
        }

        if (Session.A(Permissions.CaisseVendre))
        {
            lectures.Add(Lire(async () => _maSession = (await Api.GetAsync<SessionCaisse>("api/caisse/sessions/courante")).Valeur));
        }

        if (Session.A(Permissions.AchatsConsulter))
        {
            lectures.Add(Lire(async () => _receptionsBrouillon = (await Api.GetAsync<List<ResumeReception>>("api/achats/receptions?statut=Brouillon")).Valeur?.Count));
        }

        if (Session.A(Permissions.InventaireConsulter))
        {
            lectures.Add(Lire(async () => _inventairesEnCours = (await Api.GetAsync<List<ResumeInventaire>>("api/inventaires?statut=EnCours")).Valeur?.Count));
            lectures.Add(Lire(async () => _demarquesDeclarees = (await Api.GetAsync<List<DeclarationDemarque>>("api/demarques?statut=Declaree")).Valeur?.Count));
        }

        if (Session.A(Permissions.ExploitationConsulter))
        {
            lectures.Add(Lire(async () => _exploitation = (await Api.GetAsync<EtatExploitation>("api/exploitation/etat")).Valeur));
        }

        await Task.WhenAll(lectures);
        _charge = true;
        if (tendance is not null)
        {
            StateHasChanged();
            await tendance;
            _tendanceEnCours = false;
        }
    }

    private async Task LireTendanceAsync()
    {
        if ((await Api.GetAsync<List<VentesDuJour>>("api/rapports/tendance")).Valeur is not { } jours)
        {
            return;
        }

        // Libellé court du jour (« 17 nov. ») ; la dernière barre, aujourd'hui, est mise en avant par le graphique.
        _tendance = [.. jours.Select(j => new PointGraphique(j.Jour.ToString("d MMM", CultureInfo.CurrentCulture), j.ChiffreAffairesTtc, j.Marge))];
        _tendanceVentes = jours.Sum(j => j.ChiffreAffairesTtc);
        _tendanceMarge = jours.Sum(j => j.Marge);
    }

    private static string Nombre(int valeur) => valeur.ToString(CultureInfo.CurrentCulture);

    private static string? TauxMarge(decimal? taux) => taux is { } t ? $"{t.ToString("0.#", CultureInfo.CurrentCulture)} %" : null;

    private static async Task Lire(Func<Task> lecture)
    {
        try
        {
            await lecture();
        }
        catch (HttpRequestException)
        {
            // Réseau coupé : le bloc reste vide, les raccourcis restent disponibles.
        }
    }
}
