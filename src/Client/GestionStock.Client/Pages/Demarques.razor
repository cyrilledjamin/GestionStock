@page "/demarques"
@inject Api Api
@implements IDisposable
@inject Confirmation Confirmation
@inject Session Session

<PageTitle>@L["Demarque"] · GestionStock</PageTitle>

<h1>@L["Demarque"]</h1>
<p class="discret">@L["DemarqueIntro"]</p>

<Message Texte="@_erreur" />
<Message Texte="@_succes" Erreur="false" />

@if (Session.A(Permissions.DemarqueDeclarer))
{
    <form class="fiche" @onsubmit="Declarer">
        <h2>@L["DeclarerDemarque"]</h2>
        @if (_article is null)
        {
            <div class="champ-recherche">
                <Icone Nom="rechercher" />
                <input type="search" placeholder="@L["RechercherArticle"]" aria-label="@L["RechercherArticle"]" @bind="_recherche" @bind:event="oninput" @bind:after="Rechercher" />
            </div>
            @if (_resultats.Count > 0)
            {
                <ul class="resultats">
                    @foreach (var vendable in _resultats.DistinctBy(v => v.ArticleId))
                    {
                        <li><button type="button" class="lien" @onclick="() => _article = vendable">@vendable.CodeArticle — @vendable.Libelle</button></li>
                    }
                </ul>
            }
        }
        else
        {
            <div class="client-choisi"><span><code>@_article.CodeArticle</code> @_article.Libelle</span><Bouton Variante="VarianteBouton.Discret" NomIcone="fermer" Libelle="@L["Retirer"]" OnClick="() => _article = null" /></div>
            <div class="grille">
                <Champ Libelle="@($"{L["Quantite"]} ({Format.Unite(_article.UniteStock)})")" Requis="true"><input type="number" min="0" step="any" @bind="_quantite" required /></Champ>
                <Champ Libelle="@L["Motif"]">
                    <select @bind="_motif">
                        @foreach (var motif in MotifsDemarque.Tous)
                        {
                            <option value="@motif">@L[$"MotifDemarque.{motif}"]</option>
                        }
                    </select>
                </Champ>
                <Champ Libelle="@L["Commentaire"]"><input @bind="_commentaire" maxlength="500" /></Champ>
            </div>
            <div class="actions"><Bouton Type="submit" Variante="VarianteBouton.Principal" Occupe="_enCours">@L["Declarer"]</Bouton></div>
        }
    </form>
}

<div class="barre">
    <select @bind="_statut" @bind:after="Charger" aria-label="@L["Statut"]">
        <option value="">@L["TousStatuts"]</option>
        <option value="Declaree">@L["StatutDemarque.Declaree"]</option>
        <option value="Validee">@L["StatutDemarque.Validee"]</option>
        <option value="Refusee">@L["StatutDemarque.Refusee"]</option>
    </select>
</div>

<Tableau Colonnes="8" Charge="_charge" EstVide="_demarques.Count == 0" TexteVide="@L["AucuneDemarque"]" Legende="@L["Demarque"]">
    <Entete><th>@L["Numero"]</th><th>@L["Date"]</th><th>@L["Article"]</th><th class="nombre">@L["Quantite"]</th><th>@L["Motif"]</th><th>@L["DeclareePar"]</th><th>@L["Statut"]</th><th></th></Entete>
    <Corps>
        @foreach (var demarque in _demarques)
        {
            <tr>
                <td data-label="@L["Numero"]" class="court"><code>@demarque.Numero</code></td>
                <td data-label="@L["Date"]" class="court">@Format.Date(demarque.DeclareeLeUtc)</td>
                <td data-label="@L["Article"]"><code>@demarque.CodeArticle</code> @demarque.Libelle @if (demarque.Commentaire is not null) { <br /><small class="discret">@demarque.Commentaire</small> }</td>
                <td data-label="@L["Quantite"]" class="nombre">@Format.Quantite(demarque.Quantite) @Format.Unite(demarque.UniteStock)</td>
                <td data-label="@L["Motif"]">@L[$"MotifDemarque.{demarque.Motif}"]</td>
                <td data-label="@L["DeclareePar"]">@demarque.DeclareePar</td>
                <td data-label="@L["Statut"]">
                    <Pastille Ton="@(demarque.Statut switch { "Declaree" => Ton.Attention, "Refusee" => Ton.Danger, _ => Ton.Succes })">@L[$"StatutDemarque.{demarque.Statut}"]</Pastille>
                    @if (demarque.TraiteePar is not null) { <small class="discret"> (@demarque.TraiteePar)</small> }
                    @if (demarque.MotifRefus is not null) { <br /><small class="discret">@demarque.MotifRefus</small> }
                </td>
                <td class="actions-ligne">
                    @if (demarque.Statut == "Declaree" && Session.A(Permissions.DemarqueValider))
                    {
                        <Bouton Variante="VarianteBouton.Valider" NomIcone="valider" Desactive="_enCours" OnClick="() => Valider(demarque.Id)">@L["Valider"]</Bouton>
                        <input class="motif-refus" placeholder="@L["MotifRefus"]" aria-label="@L["MotifRefus"]" @bind="_motifsRefus[demarque.Id]" />
                        <Bouton Variante="VarianteBouton.Discret" Desactive="_enCours" OnClick="() => Refuser(demarque.Id)">@L["Refuser"]</Bouton>
                    }
                </td>
            </tr>
        }
    </Corps>
</Tableau>

@code {
    private readonly RechercheDifferee _differee = new();

    public void Dispose() => _differee.Dispose();

    // Premier chargement terminé : jusque-là, la liste montre l'attente et non « Aucun… ».
    private bool _charge;

    private List<DeclarationDemarque> _demarques = [];
    private Dictionary<Guid, string?> _motifsRefus = [];
    private string _statut = "";
    private string _recherche = "";
    private List<ArticleVendable> _resultats = [];
    private ArticleVendable? _article;
    private decimal _quantite;
    private string _motif = "Casse";
    private string? _commentaire;
    private string? _erreur;
    private bool _enCours;
    private string? _succes;

    protected override Task OnInitializedAsync() => Charger();

    private async Task Charger()
    {
        var resultat = await Api.GetAsync<List<DeclarationDemarque>>(string.IsNullOrEmpty(_statut) ? "api/demarques" : $"api/demarques?statut={_statut}");
        _demarques = resultat.Valeur ?? [];
        _erreur = resultat.Erreur;
        foreach (var demarque in _demarques)
        {
            _motifsRefus.TryAdd(demarque.Id, null);
        }
        _charge = true;
    }

    private async Task Rechercher()
    {
        if (_recherche.Trim().Length < 2)
        {
            _resultats = [];
            return;
        }

        if (await _differee.AttendreAsync() is not { } numero)
        {
            return;
        }

        var trouves = await Api.GetAsync<List<ArticleVendable>>($"api/referentiel/vendables?recherche={Uri.EscapeDataString(_recherche.Trim())}");
        if (!_differee.EstLaDerniere(numero))
        {
            return;
        }

        _erreur = trouves.Erreur;
        _resultats = trouves.Valeur ?? [];
    }

    private async Task Declarer()
    {
        // Un seul envoi à la fois : un double clic ou une connexion lente ne crée pas deux fois la même chose.
        if (_enCours)
        {
            return;
        }

        _enCours = true;
        try
        {
            var resultat = await Api.PostAsync<DeclarationDemarque>("api/demarques", new { _article!.ArticleId, Quantite = _quantite, Motif = _motif, Commentaire = _commentaire });
            _erreur = resultat.Erreur;
            if (resultat.Valeur is { } demarque)
            {
                _succes = L["DemarqueDeclaree", demarque.Numero].Value;
                _article = null;
                _quantite = 0;
                _commentaire = null;
                _recherche = "";
                _resultats = [];
                await Charger();
            }
        }
        finally
        {
            _enCours = false;
        }
    }

    private async Task Valider(Guid id)
    {
        if (!await Confirmation.DemanderAsync(L["ConfirmerValidationDemarque"].Value, L["Valider"].Value))
        {
            return;
        }

        // Un seul envoi à la fois : un double clic ou une connexion lente ne crée pas deux fois la même chose.
        if (_enCours)
        {
            return;
        }

        _enCours = true;
        try
        {
            var resultat = await Api.PostAsync<DeclarationDemarque>($"api/demarques/{id}/validation");
            _erreur = resultat.Erreur;
            await Charger();
        }
        finally
        {
            _enCours = false;
        }
    }

    private async Task Refuser(Guid id)
    {
        if (!await Confirmation.DemanderAsync(L["ConfirmerRefusDemarque"].Value, L["Refuser"].Value, danger: true))
        {
            return;
        }

        // Un seul envoi à la fois : un double clic ou une connexion lente ne crée pas deux fois la même chose.
        if (_enCours)
        {
            return;
        }

        _enCours = true;
        try
        {
            var resultat = await Api.PostAsync<DeclarationDemarque>($"api/demarques/{id}/refus", new { Motif = _motifsRefus.GetValueOrDefault(id) ?? "" });
            _erreur = resultat.Erreur;
            await Charger();
        }
        finally
        {
            _enCours = false;
        }
    }
}
