@page "/inventaires"
@inject Api Api
@inject Session Session
@inject NavigationManager Navigation

<PageTitle>@L["Inventaires"] · GestionStock</PageTitle>

<h1>@L["Inventaires"]</h1>

<div class="barre">
    <select @bind="_statut" @bind:after="Charger" aria-label="@L["Statut"]">
        <option value="">@L["TousStatuts"]</option>
        <option value="EnCours">@L["StatutInventaire.EnCours"]</option>
        <option value="Valide">@L["StatutInventaire.Valide"]</option>
        <option value="Annule">@L["StatutInventaire.Annule"]</option>
    </select>
    @if (Session.A(Permissions.InventaireCompter))
    {
        <Bouton Variante="VarianteBouton.Principal" NomIcone="ajouter" Occupe="@(_enCours == "Complet")" Desactive="_enCours is not null" OnClick='() => Creer("Complet")'>@L["NouvelInventaireComplet"]</Bouton>
        <Bouton NomIcone="ajouter" Occupe="@(_enCours == "Partiel")" Desactive="_enCours is not null" OnClick='() => Creer("Partiel")'>@L["NouvelInventairePartiel"]</Bouton>
    }
</div>

<Message Texte="@_erreur" />

<Tableau Colonnes="6" Charge="_charge" EstVide="_inventaires.Count == 0" TexteVide="@L["AucunInventaire"]" Legende="@L["Inventaires"]">
    <Entete><th>@L["Numero"]</th><th>@L["Type"]</th><th>@L["Date"]</th><th>@L["CreePar"]</th><th class="nombre">@L["Comptes"]</th><th>@L["Statut"]</th></Entete>
    <Corps>
        @foreach (var inventaire in _inventaires)
        {
            <tr>
                <td data-label="@L["Numero"]" class="court"><a href="inventaires/@inventaire.Id"><code>@inventaire.Numero</code></a></td>
                <td data-label="@L["Type"]">@L[$"TypeInventaire.{inventaire.Type}"]</td>
                <td data-label="@L["Date"]" class="court">@Format.Date(inventaire.CreeLeUtc)</td>
                <td data-label="@L["CreePar"]">@inventaire.CreePar</td>
                <td data-label="@L["Comptes"]" class="nombre">@inventaire.NombreComptees / @inventaire.NombreLignes</td>
                <td data-label="@L["Statut"]"><Pastille Ton="@(inventaire.Statut switch { "EnCours" => Ton.Attention, "Annule" => Ton.Neutre, _ => Ton.Succes })">@L[$"StatutInventaire.{inventaire.Statut}"]</Pastille></td>
            </tr>
        }
    </Corps>
</Tableau>

@code {
    // Premier chargement terminé : jusque-là, la liste montre l'attente et non « Aucun… ».
    private bool _charge;

    private List<ResumeInventaire> _inventaires = [];
    private string _statut = "";
    private string? _erreur;
    // Type d'inventaire en cours de création (bouton occupé), null sinon.
    private string? _enCours;

    protected override Task OnInitializedAsync() => Charger();

    private async Task Charger()
    {
        var resultat = await Api.GetAsync<List<ResumeInventaire>>(string.IsNullOrEmpty(_statut) ? "api/inventaires" : $"api/inventaires?statut={_statut}");
        _inventaires = resultat.Valeur ?? [];
        _erreur = resultat.Erreur;
        _charge = true;
    }

    private async Task Creer(string type)
    {
        // Un seul envoi à la fois : un double clic ou une connexion lente ne crée pas deux fois la même chose.
        if (_enCours is not null)
        {
            return;
        }

        _enCours = type;
        try
        {
            var resultat = await Api.PostAsync<DetailInventaire>("api/inventaires", new { Type = type, Articles = Array.Empty<Guid>() });
            _erreur = resultat.Erreur;
            if (resultat.Valeur is { } inventaire)
            {
                Navigation.NavigateTo($"inventaires/{inventaire.Inventaire.Id}");
            }
        }
        finally
        {
            _enCours = null;
        }
    }
}
