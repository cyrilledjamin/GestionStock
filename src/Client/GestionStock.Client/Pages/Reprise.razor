@page "/reprise"
@inject Api Api
@inject IJSRuntime Js

<PageTitle>@L["Reprise"] · GestionStock</PageTitle>

<h1>@L["Reprise"]</h1>
<p class="discret">@L["RepriseIntro"]</p>

<div class="fiche">
    <h2>1. @L["RepriseEtape1"]</h2>
    <div class="actions">
        <Bouton NomIcone="telecharger" OnClick="() => Telecharger(false)">@L["ModeleVide"]</Bouton>
        <Bouton NomIcone="telecharger" OnClick="() => Telecharger(true)">@L["ModeleExemple"]</Bouton>
    </div>
</div>

<div class="fiche">
    <h2>2. @L["RepriseEtape2"]</h2>
    <Champ Libelle="@L["FichierReprise"]"><InputFile OnChange="Choisir" accept=".xlsx" /></Champ>
    @if (_nomFichier is not null)
    {
        <p class="discret">@_nomFichier</p>
    }
    <div class="actions">
        <Bouton Variante="VarianteBouton.Principal" NomIcone="valider" Occupe="@(_enCours == true)" Desactive="@(_fichier is null || _enCours is not null)" OnClick="() => Envoyer(simulation: true)">@L["Controler"]</Bouton>
        <Bouton Variante="VarianteBouton.Valider" Occupe="@(_enCours == false)" Desactive="@(_fichier is null || _enCours is not null || _rapport is not { Erreurs.Count: 0 } || _rapport.Importe)" OnClick="() => Envoyer(simulation: false)">@L["Importer"]</Bouton>
    </div>
</div>

<Message Texte="@_erreur" />

@if (_rapport is not null)
{
    <div class="fiche">
        <h2>@(_rapport.Importe ? L["ImportReussi"] : _rapport.Erreurs.Count == 0 ? L["ControleReussi"] : L["ControleErreurs", _rapport.Erreurs.Count])</h2>
        <div class="indicateurs resume">
            <Indicateur Libelle="@L["Lignes"]" Valeur="@N(_rapport.Lignes)" />
            <Indicateur Libelle="@L["Articles"]" Valeur="@N(_rapport.Articles)" />
            <Indicateur Libelle="@L["Conditionnements"]" Valeur="@N(_rapport.Conditionnements)" />
            <Indicateur Libelle="@L["Codes"]" Valeur="@N(_rapport.CodesBarres)" />
            <Indicateur Libelle="@L["PrixFixes"]" Valeur="@N(_rapport.Prix)" />
        </div>
        @if (_rapport.InventaireOuvertureId is { } ouverture)
        {
            <Message Texte="@L["OuvertureCreee", _rapport.InventaireOuvertureNumero ?? ""]" Erreur="false" />
            <a class="bouton principal" href="inventaires/@ouverture"><Icone Nom="aller" />@L["OuvrirInventaire"]</a>
        }
        @if (_rapport.Erreurs.Count > 0)
        {
            <Tableau Colonnes="4" Legende="@L["Erreur"]">
                <Entete><th class="nombre">@L["Ligne"]</th><th>@L["Colonne"]</th><th>@L["Erreur"]</th><th>@L["Valeur"]</th></Entete>
                <Corps>
                    @foreach (var erreur in _rapport.Erreurs)
                    {
                        <tr>
                            <td data-label="@L["Ligne"]" class="nombre">@(erreur.Ligne > 0 ? erreur.Ligne : "")</td>
                            <td data-label="@L["Colonne"]">@erreur.Colonne</td>
                            <td data-label="@L["Erreur"]">@erreur.Message</td>
                            <td data-label="@L["Valeur"]"><code>@erreur.Detail</code></td>
                        </tr>
                    }
                </Corps>
            </Tableau>
        }
    </div>
}

@code {
    private const long TailleMax = 5 * 1024 * 1024;

    private byte[]? _fichier;
    private string? _nomFichier;
    private RapportReprise? _rapport;
    private string? _erreur;
    // Envoi en cours : true pour le contrôle, false pour l'import, null sinon (bouton occupé, double clic sans effet).
    private bool? _enCours;

    private static string N(int valeur) => valeur.ToString(System.Globalization.CultureInfo.CurrentCulture);

    private async Task Telecharger(bool exemple)
    {
        var octets = await Api.GetOctetsAsync($"api/reprise/modele.xlsx?exemple={exemple.ToString().ToLowerInvariant()}");
        _erreur = octets is null ? L["FichierIndisponible"].Value : null;
        if (octets is not null)
        {
            await Js.InvokeVoidAsync(
                "gestionStock.telecharger",
                exemple ? "reprise-exemple.xlsx" : "reprise-modele.xlsx",
                "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet",
                Convert.ToBase64String(octets));
        }
    }

    private async Task Choisir(InputFileChangeEventArgs e)
    {
        _rapport = null;
        _erreur = null;
        if (e.File.Size > TailleMax)
        {
            _fichier = null;
            _erreur = L["FichierTropGros"].Value;
            return;
        }

        using var copie = new MemoryStream();
        await e.File.OpenReadStream(TailleMax).CopyToAsync(copie);
        _fichier = copie.ToArray();
        _nomFichier = e.File.Name;
    }

    private async Task Envoyer(bool simulation)
    {
        if (_enCours is not null)
        {
            return;
        }

        _enCours = simulation;
        Resultat<RapportReprise> resultat;
        try
        {
            resultat = await Api.EnvoyerFichierAsync<RapportReprise>(simulation ? "api/reprise/simulation" : "api/reprise/import", _fichier!);
        }
        finally
        {
            _enCours = null;
        }

        _erreur = resultat.Erreur;
        _rapport = resultat.Valeur ?? _rapport;
    }
}
