@page "/sessions"
@inject Api Api
@inject Confirmation Confirmation
@inject Session Session

<PageTitle>@L["SessionsCaisse"] · GestionStock</PageTitle>

<h1>@L["SessionsCaisse"]</h1>

<div class="barre">
    <select @bind="_statut" @bind:after="Charger">
        <option value="">@L["TousStatuts"]</option>
        <option value="Ouverte">@L["StatutSession.Ouverte"]</option>
        <option value="Comptee">@L["StatutSession.Comptee"]</option>
        <option value="Validee">@L["StatutSession.Validee"]</option>
    </select>
</div>

<Message Texte="@_erreur" />
<Message Texte="@_succes" Erreur="false" />

@if (_aCloturer is { } aCloturer)
{
    @* Session restée ouverte qui bloque un poste : le Gérant la compte et la clôture à la place de son titulaire (décision 36). *@
    <form class="fiche etroite" @onsubmit="CloturerAPlace">
        <h2>@L["CloturerSessionDe", aCloturer.AfficheCaissier, aCloturer.NumeroCaisse]</h2>
        <p class="discret">@L["CloturerAPlaceAide", Format.Date(aCloturer.OuvertureUtc)]</p>
        <ComptageEspeces @bind-Total="_especesComptees" />
        <div class="actions">
            <button type="submit" class="principal">@L["CloturerAvec", Format.Montant(_especesComptees)]</button>
            <button type="button" @onclick="() => _aCloturer = null">@L["Annuler"]</button>
        </div>
    </form>
}

<table class="cartes">
    <thead>
        <tr>
            <th>@L["Poste"]</th><th>@L["Caissier"]</th><th>@L["Ouverture"]</th><th class="nombre">@L["Ventes"]</th>
            <th class="nombre">@L["EspecesTheoriques"]</th><th class="nombre">@L["EspecesComptees"]</th><th class="nombre">@L["Ecart"]</th><th>@L["Statut"]</th><th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var session in _sessions)
        {
            <tr class="@(session.Ecart < 0 ? "negatif" : "")">
                <td data-label="@L["Poste"]">@session.NumeroCaisse</td>
                <td data-label="@L["Caissier"]">@session.AfficheCaissier</td>
                <td data-label="@L["Ouverture"]" class="court">@Format.Date(session.OuvertureUtc)</td>
                <td data-label="@L["Ventes"]" class="nombre">@Format.Montant(session.Totaux.Ventes - session.Totaux.Avoirs)</td>
                <td data-label="@L["EspecesTheoriques"]" class="nombre">@Format.Montant(session.Totaux.EspecesTheoriques)</td>
                <td data-label="@L["EspecesComptees"]" class="nombre">@(session.EspecesComptees is { } comptees ? Format.Montant(comptees) : "")</td>
                <td data-label="@L["Ecart"]" class="nombre">@(session.Ecart is { } ecart ? Format.Montant(ecart) : "")</td>
                <td data-label="@L["Statut"]">
                    @L[$"StatutSession.{session.Statut}"]
                    @if (session.ClotureePar is { } par && par != session.Caissier)
                    {
                        <small class="pastille brouillon">@L["CompteePar", session.NomClotureePar ?? par]</small>
                    }
                    @if (session.ValideePar is not null) { <small class="discret">(@(session.NomValideePar ?? session.ValideePar))</small> }
                </td>
                <td>
                    @if (session.Statut == "Comptee" && Session.A(Permissions.SessionsValider))
                    {
                        <button class="lien" @onclick="() => Valider(session.Id)">@L["ValiderEcart"]</button>
                    }
                    else if (session.Statut == "Ouverte" && Session.A(Permissions.SessionsCloturer))
                    {
                        <button class="lien" @onclick="() => Preparer(session)">@L["CloturerAPlace"]</button>
                    }
                </td>
            </tr>
        }
        @if (!_charge)
        {
            <tr><td colspan="9"><Chargement /></td></tr>
        }
        else if (_sessions.Count == 0)
        {
            <tr><td colspan="9" class="vide">@L["AucuneSession"]</td></tr>
        }
    </tbody>
</table>

@code {
    // Premier chargement terminé : jusque-là, la liste montre l'attente et non « Aucun… ».
    private bool _charge;

    private List<SessionCaisse> _sessions = [];
    private string _statut = "";
    private string? _erreur;
    private string? _succes;
    private SessionCaisse? _aCloturer;
    private decimal _especesComptees;

    protected override Task OnInitializedAsync() => Charger();

    private async Task Charger()
    {
        var url = string.IsNullOrEmpty(_statut) ? "api/caisse/sessions" : $"api/caisse/sessions?statut={_statut}";
        var resultat = await Api.GetAsync<List<SessionCaisse>>(url);
        _sessions = resultat.Valeur ?? [];
        _erreur = resultat.Erreur;
        _charge = true;
    }

    private void Preparer(SessionCaisse session)
    {
        _aCloturer = session;
        _especesComptees = 0;
        _succes = null;
        _erreur = null;
    }

    private async Task CloturerAPlace()
    {
        var session = _aCloturer!;
        var resultat = await Api.PostAsync<SessionCaisse>($"api/caisse/sessions/{session.Id}/cloture", new { EspecesComptees = _especesComptees });
        _erreur = resultat.Erreur;
        if (resultat.Valeur is { } cloturee)
        {
            _succes = L["SessionClotureeAPlace", cloturee.NumeroCaisse, cloturee.AfficheCaissier, Format.Montant(cloturee.Ecart ?? 0)];
            _aCloturer = null;
            await Charger();
        }
    }

    private async Task Valider(Guid id)
    {
        if (!await Confirmation.DemanderAsync(L["ConfirmerValidationEcart"].Value))
        {
            return;
        }

        var resultat = await Api.PostAsync<SessionCaisse>($"api/caisse/sessions/{id}/validation");
        _erreur = resultat.Erreur;
        await Charger();
    }
}
