@page "/controles"
@inject Api Api
@inject Session Session
@inject Confirmation Confirmation

<PageTitle>@L["Controles"] · GestionStock</PageTitle>

<h1>@L["Controles"]</h1>
<p class="discret">@L["ControlesAide"]</p>

<Message Texte="@_erreur" />
<Message Texte="@_succes" Erreur="false" />

<section class="bloc-accueil">
    <h2>@L["DernierControle"]</h2>
    <div class="indicateurs">
        @if (_etat?.DernierControle is { } dernier)
        {
            <Indicateur Libelle="@($"{Format.Date(dernier.DebutUtc)} · {(dernier.Declencheur == "systeme" ? L["ControlePlanifie"].Value : dernier.Declencheur)}")"
                        Valeur="@L[$"StatutControle.{dernier.Statut}"]" Detail="@L["SoldesControles", dernier.SoldesControles, dernier.Ecarts]"
                        Ton="@(dernier.Statut == "Echoue" ? Ton.Danger : _etat.ControleEnRetard ? Ton.Attention : Ton.Succes)">
                @if (dernier.Message is { Length: > 0 } message)
                {
                    <small><code>@message</code></small>
                }
            </Indicateur>
        }
        else if (_etat is not null)
        {
            <Indicateur Libelle="@L["AucunControle"]" Valeur="—" Ton="Ton.Attention" />
        }
        <Indicateur Libelle="@L["EcartsOuverts"]" Valeur="@((_etat?.EcartsOuverts ?? 0).ToString(System.Globalization.CultureInfo.CurrentCulture))"
                    Detail="@L["ControleNocturne"]" Ton="@(_etat?.EcartsOuverts > 0 ? Ton.Danger : Ton.Neutre)" />
    </div>
    @if (Session.A(Permissions.ControlesLancer))
    {
        <p><Bouton Variante="VarianteBouton.Valider" NomIcone="controles" Occupe="_enCours" OnClick="Lancer">@L["LancerControle"]</Bouton>
            @if (_enCours) { <span class="discret" role="status"> @L["ControleEnCours"]</span> }</p>
    }
</section>

<h2>@L["Ecarts"]</h2>
<div class="barre">
    <select @bind="_filtre" @bind:after="ChargerEcarts" aria-label="@L["Statut"]">
        <option value="Ouvert">@L["StatutEcart.Ouvert"]</option>
        <option value="Reconstruit">@L["StatutEcart.Reconstruit"]</option>
        <option value="Disparu">@L["StatutEcart.Disparu"]</option>
        <option value="">@L["Toutes"]</option>
    </select>
</div>

<Tableau Colonnes="7" Charge="_charge" EstVide="_ecarts.Count == 0" TexteVide="@L["AucunEcart"]" Legende="@L["Ecarts"]">
    <Entete><th>@L["Solde"]</th><th>@L["Designation"]</th><th>@L["SelonJournal"]</th><th>@L["Enregistre"]</th><th>@L["Detecte"]</th><th>@L["Statut"]</th><th></th></Entete>
    <Corps>
        @foreach (var ecart in _ecarts)
        {
            <tr class="@(ecart.Statut == "Ouvert" ? "" : "inactif")">
                <td data-label="@L["Solde"]"><strong>@L[$"DomaineSolde.{ecart.Domaine}"]</strong><br /><small class="discret">@L[$"GrandeurSolde.{ecart.Grandeur}"]</small></td>
                <td data-label="@L["Designation"]">@ecart.Libelle</td>
                <td data-label="@L["SelonJournal"]" class="nombre">@Valeur(ecart, ecart.Attendu)</td>
                <td data-label="@L["Enregistre"]" class="nombre">@Valeur(ecart, ecart.Constate)</td>
                <td data-label="@L["Detecte"]" class="court">@Format.Date(ecart.DetecteUtc)</td>
                <td data-label="@L["Statut"]">
                    <Pastille Ton="@(ecart.Statut == "Ouvert" ? Ton.Danger : ecart.Statut == "Reconstruit" ? Ton.Succes : Ton.Neutre)">@L[$"StatutEcart.{ecart.Statut}"]</Pastille>
                    @if (ecart.ResolutionUtc is { } le)
                    {
                        <br /><small class="discret">@(ecart.ResoluPar is { } par ? $"{par} · " : "")@Format.Date(le)</small>
                    }
                </td>
                <td>
                    @if (ecart.Statut == "Ouvert" && Session.A(Permissions.SoldesReconstruire))
                    {
                        <Bouton Variante="VarianteBouton.Discret" Desactive="_enCours" OnClick="() => Reconstruire(ecart)">@L["Reconstruire"]</Bouton>
                    }
                </td>
            </tr>
        }
    </Corps>
</Tableau>

@code {
    // Premier chargement terminé : jusque-là, la liste montre l'attente et non « Aucun… ».
    private bool _charge;

    private EtatExploitation? _etat;
    private List<EcartSolde> _ecarts = [];
    private string _filtre = "Ouvert";
    private bool _enCours;
    private string? _erreur;
    private string? _succes;

    protected override async Task OnInitializedAsync()
    {
        await ChargerEtat();
        await ChargerEcarts();
        _charge = true;
    }

    private async Task ChargerEtat()
    {
        var resultat = await Api.GetAsync<EtatExploitation>("api/exploitation/etat");
        _etat = resultat.Valeur;
        _erreur = resultat.Erreur;
    }

    private async Task ChargerEcarts()
    {
        var url = _filtre.Length == 0 ? "api/exploitation/ecarts" : $"api/exploitation/ecarts?statut={_filtre}";
        var resultat = await Api.GetAsync<List<EcartSolde>>(url);
        _ecarts = resultat.Valeur ?? [];
        _erreur ??= resultat.Erreur;
    }

    /// <summary>Contrôle hors de son passage nocturne (Administrateur) ; il peut prendre quelques secondes.</summary>
    private async Task Lancer()
    {
        _enCours = true;
        _succes = null;
        var resultat = await Api.PostAsync<ControleSoldes>("api/exploitation/controles", delai: Api.DelaiLong);
        _enCours = false;
        _erreur = resultat.Erreur;
        if (resultat.Valeur is { } controle)
        {
            _succes = L["ControleTermine", controle.SoldesControles, controle.Ecarts].Value;
            await ChargerEtat();
            await ChargerEcarts();
        }
    }

    /// <summary>
    /// Reconstruction depuis le journal (Administrateur) : tous les soldes de l'article, ou la dette du client. Le
    /// journal fait foi ; aucun mouvement n'est écrit.
    /// </summary>
    private async Task Reconstruire(EcartSolde ecart)
    {
        if (!await Confirmation.DemanderAsync(L["ConfirmerReconstruction", ecart.Libelle].Value, L["Reconstruire"].Value))
        {
            return;
        }

        _enCours = true;
        _succes = null;
        var resultat = await Api.PostAsync<List<EcartSolde>>($"api/exploitation/ecarts/{ecart.Id}/reconstruction");
        _enCours = false;
        _erreur = resultat.Erreur;
        if (resultat.Reussi)
        {
            _succes = L["SoldeReconstruit"].Value;
            await ChargerEtat();
            await ChargerEcarts();
        }
    }

    private static string Valeur(EcartSolde ecart, decimal valeur) =>
        ecart.Grandeur is "Cump" or "SoldeDu" ? Format.Montant(valeur) : Format.Quantite(valeur);
}
