@page "/stock"
@inject Api Api
@implements IDisposable

<PageTitle>@L["Stock"] · GestionStock</PageTitle>

<h1>@L["Stock"]</h1>
<p class="discret">@L["StockIntro"]</p>

<div class="barre">
    <input type="search" placeholder="@L["Rechercher"]" @bind="_recherche" @bind:event="oninput" @bind:after="RechercherDiffere" />
</div>

<Message Texte="@_erreur" />

<table class="cartes">
    <thead>
        <tr>
            <th>@L["Code"]</th><th>@L["Libelle"]</th>
            <th class="nombre">@L["Physique"]</th><th class="nombre">@L["Disponible"]</th>
            <th class="nombre">@L["Cump"]</th><th class="nombre">@L["ValeurStock"]</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var ligne in Lignes)
        {
            <tr class="@(ligne.Solde.QuantitePhysique < 0 ? "negatif" : "")">
                <td data-label="@L["Code"]"><a href="stock/@ligne.Article.Id"><code>@ligne.Article.Code</code></a></td>
                <td data-label="@L["Libelle"]">@Format.Libelle(ligne.Article)</td>
                <td data-label="@L["Physique"]" class="nombre">@Format.Quantite(ligne.Solde.QuantitePhysique, ligne.Article.PrecisionQuantite) @Format.Unite(ligne.Article.UniteStock)</td>
                <td data-label="@L["Disponible"]" class="nombre">@Format.Quantite(ligne.Solde.QuantiteDisponible, ligne.Article.PrecisionQuantite)</td>
                <td data-label="@L["Cump"]" class="nombre">@Format.Montant(ligne.Solde.Cump)</td>
                <td data-label="@L["ValeurStock"]" class="nombre">@Format.Montant(ligne.Solde.QuantitePhysique * ligne.Solde.Cump)</td>
            </tr>
        }
        @if (!_charge)
        {
            <tr><td colspan="6"><Chargement /></td></tr>
        }
        else if (!Lignes.Any())
        {
            <tr><td colspan="6" class="vide">@L["AucunStock"]</td></tr>
        }
    </tbody>
    <tfoot>
        @* Sans recherche : valeur de tout le stock (calculée par le serveur) ; avec recherche : celle des lignes affichées. *@
        <tr><td colspan="5" class="nombre">@L["Total"]</td><th class="nombre">@Format.Montant(string.IsNullOrWhiteSpace(_recherche) && _valeur is { } valeur ? valeur.Valeur : Lignes.Sum(l => l.Solde.QuantitePhysique * l.Solde.Cump))</th></tr>
    </tfoot>
</table>
@if (_tronquee)
{
    <p class="discret">@L["ListeTronquee", TailleListe]</p>
}

@code {
    // Premier chargement terminé : jusque-là, la liste montre l'attente et non « Aucun… ».
    private bool _charge;

    private List<(Article Article, SoldeStock Solde)> _lignes = [];
    private string _recherche = "";
    private string? _erreur;

    private const int TailleListe = 100;
    private readonly RechercheDifferee _differee = new();
    private ValeurStock? _valeur;
    private bool _tronquee;

    private IEnumerable<(Article Article, SoldeStock Solde)> Lignes => _lignes;

    protected override async Task OnInitializedAsync()
    {
        var valeur = Api.GetAsync<ValeurStock>("api/stock/valeur");
        await Task.WhenAll(valeur, Charger(null));
        _valeur = valeur.Result.Valeur;
        _charge = true;
    }

    private async Task RechercherDiffere()
    {
        if (await _differee.AttendreAsync() is { } numero)
        {
            await Charger(numero);
        }
    }

    /// <summary>
    /// Une page d'articles cherchés par le serveur (code ou libellé), puis leurs seuls soldes : jamais tout le catalogue ni
    /// tous les soldes (ENF10).
    /// </summary>
    private async Task Charger(int? numero)
    {
        var articles = await Api.GetAsync<List<Article>>(
            $"api/referentiel/articles?recherche={Uri.EscapeDataString(_recherche)}&inclureInactifs=true&taille={TailleListe + 1}");
        var trouves = articles.Valeur ?? [];
        var tronquee = trouves.Count > TailleListe;
        trouves = [.. trouves.Take(TailleListe)];
        var soldes = trouves.Count == 0
            ? new Resultat<List<SoldeStock>>([], null)
            : await Api.GetAsync<List<SoldeStock>>($"api/stock/soldes?articles={string.Join(',', trouves.Select(a => a.Id))}");
        if (numero is { } n && !_differee.EstLaDerniere(n))
        {
            return;
        }

        _erreur = articles.Erreur ?? soldes.Erreur;
        _tronquee = tronquee;
        var parId = (soldes.Valeur ?? []).ToDictionary(s => s.ArticleId);
        _lignes = [.. trouves
            .Where(a => parId.ContainsKey(a.Id))
            .Select(a => (a, parId[a.Id]))
            .OrderBy(l => l.a.Code, StringComparer.Ordinal)];
    }

    public void Dispose() => _differee.Dispose();
}
