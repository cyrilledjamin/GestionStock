@page "/fournisseurs"
@inject Api Api
@inject Session Session

<PageTitle>@L["Fournisseurs"] · GestionStock</PageTitle>

<h1>@L["Fournisseurs"]</h1>

<div class="barre">
    <label class="case"><input type="checkbox" @bind="_inclureInactifs" @bind:after="Charger" /> @L["InclureInactifs"]</label>
    @if (Session.A(Permissions.FournisseursGerer) && _edition is null)
    {
        <Bouton Variante="VarianteBouton.Principal" NomIcone="ajouter" OnClick="() => _edition = new Edition()">@L["NouveauFournisseur"]</Bouton>
    }
</div>

<Message Texte="@_erreur" />

@if (_edition is not null)
{
    <form class="fiche" @onsubmit="Enregistrer">
        <h2>@(_edition.Id is null ? L["NouveauFournisseur"] : _edition.Nom)</h2>
        <div class="grille">
            <Champ Libelle="@L["Nom"]" Requis="true"><input @bind="_edition.Nom" required maxlength="200" /></Champ>
            <Champ Libelle="@L["Telephone"]"><input @bind="_edition.Telephone" maxlength="30" placeholder="+237 6…" /></Champ>
            @if (_edition.Id is not null)
            {
                <label class="case"><input type="checkbox" @bind="_edition.Actif" /> @L["Actif"]</label>
            }
        </div>
        <div class="actions">
            <Bouton Type="submit" Variante="VarianteBouton.Principal" Occupe="_enCours">@L["Enregistrer"]</Bouton>
            <Bouton OnClick="() => _edition = null">@L["Annuler"]</Bouton>
        </div>
    </form>
}

<Tableau Colonnes="4" Charge="_charge" EstVide="_fournisseurs.Count == 0" TexteVide="@L["AucunFournisseur"]" Legende="@L["Fournisseurs"]">
    <Entete><th>@L["Nom"]</th><th>@L["Telephone"]</th><th>@L["Etat"]</th><th></th></Entete>
    <Corps>
        @foreach (var fournisseur in _fournisseurs)
        {
            <tr class="@(fournisseur.Actif ? "" : "inactif")">
                <td data-label="@L["Nom"]"><strong>@fournisseur.Nom</strong></td>
                <td data-label="@L["Telephone"]">@fournisseur.Telephone</td>
                <td data-label="@L["Etat"]"><Pastille Ton="@(fournisseur.Actif ? Ton.Succes : Ton.Neutre)">@(fournisseur.Actif ? L["Actif"] : L["Inactif"])</Pastille></td>
                <td class="actions-ligne">
                    @if (Session.A(Permissions.FournisseursGerer))
                    {
                        <Bouton Variante="VarianteBouton.Discret" NomIcone="modifier" OnClick="() => _edition = new Edition { Id = fournisseur.Id, Nom = fournisseur.Nom, Telephone = fournisseur.Telephone, Actif = fournisseur.Actif }">@L["Modifier"]</Bouton>
                    }
                </td>
            </tr>
        }
    </Corps>
</Tableau>

@code {
    // Premier chargement terminé : jusque-là, la liste montre l'attente et non « Aucun… ».
    private bool _charge;

    private List<Fournisseur> _fournisseurs = [];
    private bool _inclureInactifs;
    private string? _erreur;
    private bool _enCours;
    private Edition? _edition;

    protected override Task OnInitializedAsync() => Charger();

    private async Task Charger()
    {
        var resultat = await Api.GetAsync<List<Fournisseur>>($"api/achats/fournisseurs?inclureInactifs={_inclureInactifs}");
        _fournisseurs = resultat.Valeur ?? [];
        _erreur = resultat.Erreur;
        _charge = true;
    }

    private async Task Enregistrer()
    {
        // Un seul envoi à la fois : un double clic ou une connexion lente ne crée pas deux fois la même chose.
        if (_enCours)
        {
            return;
        }

        _enCours = true;
        try
        {
            var edition = _edition!;
            var corps = new { edition.Nom, edition.Telephone, edition.Actif };
            var resultat = edition.Id is null
                ? await Api.PostAsync<Fournisseur>("api/achats/fournisseurs", corps)
                : await Api.PutAsync<Fournisseur>($"api/achats/fournisseurs/{edition.Id}", corps);
            _erreur = resultat.Erreur;
            if (resultat.Reussi)
            {
                _edition = null;
                await Charger();
            }
        }
        finally
        {
            _enCours = false;
        }
    }

    private sealed class Edition
    {
        public Guid? Id { get; init; }
        public string Nom { get; set; } = "";
        public string? Telephone { get; set; }
        public bool Actif { get; set; } = true;
    }
}
