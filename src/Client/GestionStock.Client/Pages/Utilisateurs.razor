@page "/utilisateurs"
@inject Api Api
@inject NavigationManager Navigation

<PageTitle>@L["Utilisateurs"] · GestionStock</PageTitle>

<h1>@L["Utilisateurs"]</h1>

<Message Texte="@_erreur" />

<form class="fiche" @onsubmit="Creer">
    <h2>@L["NouveauCompte"]</h2>
    <div class="grille">
        <label>@L["Prenom"] <input @bind="_prenom" required maxlength="100" autocomplete="off" /></label>
        <label>@L["Nom"] <input @bind="_nom" required maxlength="100" autocomplete="off" /></label>
        <label>@L["Telephone"] <input @bind="_telephone" maxlength="20" placeholder="+237 6XX XX XX XX" autocomplete="off" /></label>
        <label>@L["Matricule"] <input @bind="_matricule" maxlength="20" placeholder="@L["MatriculeGenere"]" autocomplete="off" /></label>
        <label>@L["Langue"]
            <select @bind="_langue">
                <option value="fr">Français</option>
                <option value="en">English</option>
            </select>
        </label>
        <label>@L["MotDePasseProvisoire"]
            <ChampMotDePasse @bind-Valeur="_motDePasse" Requis="true" Autocomplete="new-password" />
        </label>
    </div>
    <ChoixRoles Roles="_roles" />
    <p class="discret">@L["MotDePasseProvisoireAide"] @L["MotDePasseRegle"]</p>
    <div class="actions"><button type="submit" class="principal" disabled="@_enCours">@L["CreerCompte"]</button></div>
</form>

<div class="barre">
    <label class="case"><input type="checkbox" @bind="_avecDesactives" /> @L["AfficherDesactives"]</label>
</div>

<table>
    <thead><tr><th>@L["Nom"]</th><th>@L["Matricule"]</th><th>@L["Roles"]</th><th>@L["Telephone"]</th><th>@L["Statut"]</th></tr></thead>
    <tbody>
        @foreach (var compte in _comptes.Where(c => _avecDesactives || c.Actif))
        {
            <tr class="@(compte.Actif ? "" : "inactif")">
                <td><a href="utilisateurs/@compte.Id">@compte.NomComplet</a></td>
                <td><code>@compte.Matricule</code></td>
                <td>@string.Join(", ", compte.Roles.Select(r => L[$"Role.{r}"].Value))</td>
                <td>@compte.Telephone</td>
                <td>
                    <span class="pastille @(compte.Actif ? "validee" : "brouillon")">@(compte.Actif ? L["Actif"] : L["Desactive"])</span>
                    @if (compte.MotDePasseProvisoire) { <small class="discret"> @L["MotDePasseProvisoire"]</small> }
                </td>
            </tr>
        }
    </tbody>
</table>

@code {
    private List<CompteUtilisateur> _comptes = [];
    private string _prenom = "";
    private string _nom = "";
    private string? _telephone;
    private string? _matricule;
    private string _langue = "fr";
    private string _motDePasse = "";
    private HashSet<string> _roles = [];
    private bool _avecDesactives;
    private bool _enCours;
    private string? _erreur;

    protected override Task OnInitializedAsync() => Charger();

    private async Task Charger()
    {
        var resultat = await Api.GetAsync<List<CompteUtilisateur>>("api/identite/utilisateurs");
        _comptes = resultat.Valeur ?? [];
        _erreur = resultat.Erreur;
    }

    private async Task Creer()
    {
        _enCours = true;
        var resultat = await Api.PostAsync<FicheCompte>("api/identite/utilisateurs", new
        {
            Matricule = _matricule,
            Prenom = _prenom,
            Nom = _nom,
            Telephone = _telephone,
            Roles = _roles.ToList(),
            Langue = _langue,
            MotDePasse = _motDePasse,
        });
        _enCours = false;
        _erreur = resultat.Erreur;
        if (resultat.Valeur is { } fiche)
        {
            Navigation.NavigateTo($"utilisateurs/{fiche.Compte.Id}?cree=1");
        }
    }
}
