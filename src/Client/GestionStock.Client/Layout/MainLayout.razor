@inherits LayoutComponentBase
@implements IDisposable
@inject Session Session
@inject NavigationManager Navigation
@inject IJSRuntime Js
@inject Api Api
@inject EtatConnexion Connexion
@inject CaisseHorsLigne HorsLigne

@if (!Session.EstConnecte)
{
    <main class="seul">@Body</main>
}
else
{
    <a class="evitement" href="@($"{Navigation.ToBaseRelativePath(Navigation.Uri).Split('#')[0]}#contenu")">@L["AllerAuContenu"]</a>
    <div class="cadre @(_menuOuvert ? "menu-ouvert" : "")">
        @* Écran étroit : barre du haut avec le bouton du menu en tiroir. *@
        <header class="barre-haut">
            <span class="marque"><MarqueBoutique AvecLogiciel="false" /></span>
            <button class="ouvrir-menu" aria-expanded="@(_menuOuvert ? "true" : "false")" aria-controls="menu" @onclick="BasculerMenu">
                <span aria-hidden="true">☰</span> @L["Menu"]
            </button>
        </header>
        <div class="voile" @onclick="FermerMenu"></div>
        <nav class="menu" id="menu" aria-label="@L["Menu"]">
            <div class="marque"><MarqueBoutique /></div>
            <NavLink href="" Match="NavLinkMatch.All"><Icone Nom="accueil" />@L["Accueil"]</NavLink>
            @if (Session.A(Permissions.CaisseVendre))
            {
                <NavLink href="caisse"><Icone Nom="caisse" />@L["Caisse"]</NavLink>
            }
            @if (Session.A(Permissions.SessionsConsulter))
            {
                <NavLink href="sessions"><Icone Nom="sessions" />@L["SessionsCaisse"]</NavLink>
                <NavLink href="anomalies"><Icone Nom="erreur" />@L["Anomalies"]</NavLink>
            }
            @if (Session.A(Permissions.CreditConsulter))
            {
                <NavLink href="clients"><Icone Nom="clients" />@L["Clients"]</NavLink>
            }
            @if (Session.A(Permissions.StockConsulter))
            {
                <NavLink href="stock"><Icone Nom="stock" />@L["Stock"]</NavLink>
            }
            @if (Session.A(Permissions.AchatsConsulter))
            {
                <NavLink href="receptions"><Icone Nom="receptions" />@L["Receptions"]</NavLink>
                <NavLink href="fournisseurs"><Icone Nom="fournisseurs" />@L["Fournisseurs"]</NavLink>
                <NavLink href="dettes"><Icone Nom="dettes" />@L["DettesFournisseurs"]</NavLink>
            }
            @if (Session.A(Permissions.ReferentielConsulter))
            {
                <NavLink href="articles"><Icone Nom="articles" />@L["Articles"]</NavLink>
            }
            @if (Session.A(Permissions.InventaireConsulter))
            {
                <NavLink href="inventaires"><Icone Nom="inventaires" />@L["Inventaires"]</NavLink>
                <NavLink href="demarques"><Icone Nom="demarque" />@L["Demarque"]</NavLink>
            }
            @if (Session.A(Permissions.RapportsConsulter))
            {
                <NavLink href="rapports"><Icone Nom="rapports" />@L["Rapports"]</NavLink>
            }
            @if (Session.A(Permissions.ExportsProduire))
            {
                <NavLink href="exports"><Icone Nom="exports" />@L["Exports"]</NavLink>
            }
            @if (Session.A(Permissions.RepriseImporter))
            {
                <NavLink href="reprise"><Icone Nom="reprise" />@L["Reprise"]</NavLink>
            }
            @if (Session.A(Permissions.UtilisateursGerer))
            {
                <NavLink href="utilisateurs"><Icone Nom="utilisateurs" />@L["Utilisateurs"]</NavLink>
            }
            <div class="pied-menu">
                <div class="utilisateur">@Session.Profil!.NomComplet<br /><small>@Session.Profil.Identifiant · @string.Join(", ", Session.Profil.Roles.Select(r => L[$"Role.{r}"].Value))</small></div>
                <NavLink href="mon-compte"><Icone Nom="compte" />@L["MonCompte"]</NavLink>
                <button class="lien" @onclick="ChangerLangue"><Icone Nom="langue" />@L["AutreLangue"]</button>
                <button class="lien" @onclick="Deconnecter"><Icone Nom="deconnexion" />@L["Deconnexion"]</button>
            </div>
        </nav>
        <main class="contenu" id="contenu" tabindex="-1">
            @if (!Connexion.EnLigne)
            {
                @* Serveur injoignable (7.8) : l'application continue ; la caisse garde ses opérations sur le poste. *@
                <div class="bandeau-hors-ligne" role="status"><Icone Nom="erreur" /><span>@L["HorsLigneBandeau"]</span></div>
            }
            @if (HorsLigne.EnAttente.Count > 0)
            {
                @* File des opérations faites hors ligne (7.8) : rien n'est perdu, tout part dans l'ordre. *@
                <div class="bandeau-hors-ligne" role="status">
                    <Icone Nom="sessions" />
                    <span>
                        @L["OperationsEnAttente", HorsLigne.EnAttente.Count]
                        @if (HorsLigne.BloqueePar is { } caissier)
                        {
                            <br />@L["SynchroBloquee", caissier]
                        }
                        @foreach (var refusee in HorsLigne.EnAttente.Where(o => o.Erreur is not null))
                        {
                            <br />@L["OperationRefusee", refusee.Resume, refusee.Erreur!]
                        }
                    </span>
                </div>
            }
            @Body
        </main>
    </div>
}

@code {
    protected override void OnInitialized()
    {
        Session.Changement += Rafraichir;
        Connexion.Changement += Rafraichir;
        HorsLigne.Changement += Rafraichir;
        Navigation.LocationChanged += SurNavigation;
        ExigerConnexion();
    }

    /// <summary>Menu en tiroir, ouvert sur écran étroit seulement (la feuille de style l'ignore ailleurs).</summary>
    private bool _menuOuvert;

    private void BasculerMenu() => _menuOuvert = !_menuOuvert;

    private void FermerMenu() => _menuOuvert = false;

    private void SurNavigation(object? sender, LocationChangedEventArgs e)
    {
        // Un choix dans le tiroir le referme.
        if (_menuOuvert)
        {
            _menuOuvert = false;
            InvokeAsync(StateHasChanged);
        }

        ExigerConnexion();
    }

    /// <summary>Toute page hors connexion exige une session.</summary>
    private void ExigerConnexion()
    {
        var page = Navigation.ToBaseRelativePath(Navigation.Uri);
        if (!Session.EstConnecte && !page.StartsWith("connexion", StringComparison.Ordinal))
        {
            Navigation.NavigateTo("connexion");
        }
        else if (Session.DoitChangerMotDePasse && !page.StartsWith("mon-compte", StringComparison.Ordinal))
        {
            // Mot de passe provisoire : rien d'autre n'est possible avant de le changer.
            Navigation.NavigateTo("mon-compte");
        }
    }

    private void Rafraichir() => InvokeAsync(StateHasChanged);

    private async Task ChangerLangue()
    {
        var autre = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "en" ? "fr" : "en";
        await Js.InvokeVoidAsync("localStorage.setItem", Langues.Cle, autre);
        await Api.PutAsync<object>("api/identite/moi/langue", new { Langue = autre });
        Navigation.NavigateTo(Navigation.Uri, forceLoad: true);
    }

    private async Task Deconnecter()
    {
        await Session.DeconnecterAsync();
        Navigation.NavigateTo("connexion");
    }

    public void Dispose()
    {
        Session.Changement -= Rafraichir;
        Connexion.Changement -= Rafraichir;
        HorsLigne.Changement -= Rafraichir;
        Navigation.LocationChanged -= SurNavigation;
    }
}
