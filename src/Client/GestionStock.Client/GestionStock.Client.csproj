<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">
  <!-- Client Blazor WebAssembly (back-office et caisse), servi par l'hôte. Ne référence aucun projet serveur : il
       dialogue avec l'API par HTTP et a ses propres modèles. Application installable (PWA, décision 24) : le service
       worker publié garde l'application sur le poste pour la caisse hors ligne (7.8). -->
  <PropertyGroup>
    <NeutralLanguage>fr</NeutralLanguage>
    <!-- Données de culture réduites (ENF10) : seul le fichier ICU européen (EFIGS : français, anglais…) est chargé, choisi
         par la culture de démarrage passée à Blazor.start dans index.html. -->
    <ServiceWorkerAssetsManifest>service-worker-assets.js</ServiceWorkerAssetsManifest>
  </PropertyGroup>
  <ItemGroup>
    <ServiceWorker Include="wwwroot/service-worker.js" PublishedContent="wwwroot/service-worker.published.js" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" />
    <PackageReference Include="Microsoft.Extensions.Localization" />
  </ItemGroup>
</Project>
