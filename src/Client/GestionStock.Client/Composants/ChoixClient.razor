@* Recherche et choix d'un client à crédit (nom ou téléphone). *@
@inject Api Api
@inject CacheCaisse Cache
@implements IDisposable

<div class="choix-client">
    <Message Texte="@_erreur" />
    @if (Client is null)
    {
        <input type="search" placeholder="@(Libelle ?? L["ChercherClient"])" @bind="_recherche" @bind:event="oninput" @bind:after="Rechercher" />
        @if (_resultats.Count > 0)
        {
            <ul class="resultats">
                @foreach (var client in _resultats)
                {
                    <li><button type="button" class="lien" @onclick="() => Choisir(client)">@client.Nom · @client.Telephone</button></li>
                }
            </ul>
        }
    }
    else
    {
        <div class="client-choisi">
            <span><strong>@Client.Nom</strong> · @Client.Telephone<br />
                <small class="discret">@L["SoldeDu"] @Format.Montant(Client.SoldeDu) / @L["Plafond"] @Format.Montant(Client.PlafondCredit)</small></span>
            <button type="button" class="lien" @onclick="() => Choisir(null)">✕</button>
        </div>
    }
</div>

@code {
    private readonly RechercheDifferee _differee = new();

    public void Dispose() => _differee.Dispose();

    [Parameter] public ClientCredit? Client { get; set; }

    [Parameter] public EventCallback<ClientCredit?> ClientChanged { get; set; }

    [Parameter] public string? Libelle { get; set; }

    private string _recherche = "";
    private List<ClientCredit> _resultats = [];
    private string? _erreur;

    private async Task Rechercher()
    {
        var texte = _recherche.Trim();
        if (texte.Length < 2)
        {
            _resultats = [];
            return;
        }

        if (await _differee.AttendreAsync() is not { } numero)
        {
            return;
        }

        var trouves = await Api.GetAsync<List<ClientCredit>>($"api/credit/clients?recherche={Uri.EscapeDataString(texte)}&taille=10");
        if (!_differee.EstLaDerniere(numero))
        {
            return;
        }

        if (trouves.Code == Api.CodeHorsLigne)
        {
            // Hors ligne (7.8) : clients gardés sur le poste, avec leur dernier solde connu.
            await Cache.ChargerAsync();
            trouves = new Resultat<List<ClientCredit>>(
                [.. Cache.Clients.Where(c => c.Nom.Contains(texte, StringComparison.CurrentCultureIgnoreCase) || c.Telephone.Contains(texte, StringComparison.Ordinal))], null);
        }

        _erreur = trouves.Erreur;
        _resultats = (trouves.Valeur ?? []).Where(c => c.Actif).Take(10).ToList();
    }

    private async Task Choisir(ClientCredit? client)
    {
        _recherche = "";
        _resultats = [];
        await ClientChanged.InvokeAsync(client);
    }
}
