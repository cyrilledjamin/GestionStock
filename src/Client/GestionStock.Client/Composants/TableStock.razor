@* Articles d'un rapport de stock : quantité, CUMP et valeur ; les stocks négatifs ressortent (RG22). *@
<Tableau Colonnes="4" EstVide="Lignes.Count == 0" TexteVide="@L["Aucun"]" Legende="@Legende">
    <Entete><th>@L["Article"]</th><th class="nombre">@L["Quantite"]</th><th class="nombre">@L["Cump"]</th><th class="nombre">@L["Valeur"]</th></Entete>
    <Corps>
        @foreach (var ligne in Lignes)
        {
            <tr class="@(ligne.Quantite < 0 ? "negatif" : "")">
                <td data-label="@L["Article"]"><a href="stock/@ligne.ArticleId"><code>@ligne.Code</code></a> @ligne.Libelle</td>
                <td data-label="@L["Quantite"]" class="nombre">@Format.Quantite(ligne.Quantite, ligne.PrecisionQuantite) @Format.Unite(ligne.UniteStock)</td>
                <td data-label="@L["Cump"]" class="nombre">@Format.Montant(ligne.Cump)</td>
                <td data-label="@L["Valeur"]" class="nombre">@Format.Montant(ligne.Valeur)</td>
            </tr>
        }
    </Corps>
</Tableau>

@code {
    [Parameter, EditorRequired] public List<LigneStockRapport> Lignes { get; set; } = [];

    /// <summary>Titre lu par les lecteurs d'écran.</summary>
    [Parameter] public string? Legende { get; set; }
}
