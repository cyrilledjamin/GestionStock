@* Icône SVG embarquée (aucun fichier ni police externe, utilisable hors ligne). Décorative : le texte voisin porte le sens. *@
<svg class="icone" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
    @foreach (var trace in Traces(Nom))
    {
        <path d="@trace" />
    }
</svg>

@code {
    /// <summary>Nom de l'icône, parmi <see cref="Noms"/>.</summary>
    [Parameter, EditorRequired] public string Nom { get; set; } = "";

    /// <summary>Tracés de chaque icône sur une grille de 24 × 24 (traits de 2, extrémités arrondies).</summary>
