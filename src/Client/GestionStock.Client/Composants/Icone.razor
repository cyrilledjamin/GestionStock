        ["fournisseurs"] = ["M4 21V5l8-2v18", "M12 9h8v12", "M2 21h20", "M7 8h2", "M7 12h2", "M7 16h2", "M15 13h2", "M15 17h2"],
        ["dettes"] = ["M3 7h18v12H3z", "M3 7l3-4h12l3 4", "M16 13h2"],
        ["articles"] = ["M3 12V4h8l10 10-8 8z", "M7.5 8.5h.01"],
